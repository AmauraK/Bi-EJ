---
// Estrutura comum de todas as páginas: <head> (SEO, OG, fontes, JSON-LD), navegação, rodapé,
// WhatsApp flutuante, modal de vídeo e main.js.
import '../styles/styles.css';
import { SITE, CONTATO, NAV, SOLUCOES, NUMEROS, ATUALIZADO_EM } from '../consts';

interface Props {
	titulo: string;
	descricao: string;
	/** Destino do botão "Fale com um Especialista". Nas soluções, '#formulario'. */
	ctaHref?: string;
	/** JSON-LD extra da página (Service, FAQPage, Article...). */
	jsonLd?: object | object[];
	noindex?: boolean;
}

const { titulo, descricao, ctaHref = '/contato/', jsonLd, noindex = false } = Astro.props;
const caminho = Astro.url.pathname;
const canonical = new URL(caminho, Astro.site).href;

const organizacao = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: SITE.nome,
	alternateName: SITE.nomeCompleto,
	description: `A ${SITE.nome} é a ${SITE.nomeCompleto}, a primeira empresa júnior da América Latina, fundada em ${NUMEROS.fundacao}. Consultoria estratégica feita por alunos da graduação da FGV.`,
	url: SITE.url,
	logo: SITE.logo,
	email: CONTATO.email,
	telephone: CONTATO.whatsapp,
	foundingDate: String(NUMEROS.fundacao),
	address: { '@type': 'PostalAddress', streetAddress: CONTATO.enderecoPostal.rua, addressLocality: CONTATO.enderecoPostal.cidade, addressRegion: CONTATO.enderecoPostal.uf, postalCode: CONTATO.enderecoPostal.cep, addressCountry: 'BR' },
	sameAs: [CONTATO.instagram, CONTATO.linkedin],
};
const extras = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const atualizado = ATUALIZADO_EM.split('-').reverse().join('/');
const ano = new Date().getFullYear();
import { Image } from 'astro:assets';
import logoRodape from '../assets/logo-ejfgv-rodape.png';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{titulo}</title>
		<meta name="description" content={descricao} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content={SITE.nome} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descricao} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
		<script type="application/ld+json" set:html={JSON.stringify(organizacao)} />
		{extras.map((dados) => <script type="application/ld+json" set:html={JSON.stringify(dados)} />)}
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

		<!-- CURSOR CUSTOMIZADO (Documento DS EJFGV / Grotesk Zero) -->
		<div class="cursor" id="cursor"></div>

		<!-- NAVEGAÇÃO PRINCIPAL (Documento DS EJFGV / Grotesk Zero) -->
		<nav class="gz-nav" id="mainNav" aria-label="Navegação principal">
			<a class="wordmark" href="/" aria-label="EJFGV — Início">
				<!-- Casinha do logo oficial (SITE.logo), só o símbolo -->
				<svg class="wordmark_casa" viewBox="4.5 5.5 38 33.5" aria-hidden="true">
					<g class="wordmark_telhado" fill="currentColor" fill-rule="evenodd">
						<path d="M18.036 6.63954C18.4943 6.58948 23.2304 14.4316 22.7719 16.0101C22.4154 17.0801 17.4247 16.0101 9.07269 22.427C8.76724 22.6824 8.76724 22.0706 9.37836 21.4091C15.235 15.0432 19.1563 14.89 19.2582 14.2794C19.462 13.1078 17.0176 7.55693 16.7116 8.16765C16.4061 8.83022 11.4664 17.8947 11.4664 18.3022C11.4664 18.7098 9.68403 20.1357 10.2952 17.5384C10.9064 14.9409 15.3877 7.55693 15.948 6.74188C16.5594 5.92701 17.4758 6.69064 18.036 6.63954Z" />
						<path d="M23.4805 32.2796C26.179 25.939 26.9602 22.5741 27.4048 20.6966C27.6086 19.9835 33.2105 21.9186 34.6872 24.0065C35.2741 24.8378 34.9211 28.1595 32.7715 32.4819C30.2883 32.257 27.2075 32.1429 23.4805 32.2796ZM12.0345 33.3801C11.3306 30.877 10.908 23.9744 11.5159 23.0388C12.3306 21.817 18.5435 20.3905 19.2054 20.9509C19.8423 21.539 20.8558 25.0955 19.8443 32.4819C19.7169 32.4913 19.589 32.5009 19.4603 32.5109C16.3608 32.7579 13.9339 33.0566 12.0345 33.3801ZM41.0023 34.09C41.0023 34.09 38.7669 33.1321 33.8258 32.5876C35.34 29.9759 37.0823 25.1455 36.4696 24.1084C33.7198 19.7792 24.1963 15.9602 24.3492 18.6079C24.543 23.0703 23.1207 28.8252 21.841 32.3541C21.7668 32.3581 21.6921 32.3623 21.6174 32.3665C22.1191 29.1773 23.494 19.8218 22.5666 18.5573C21.4461 17.0296 10.9046 20.8486 10.2425 22.4787C9.62114 23.9606 9.58297 30.4656 11.1807 33.5337C6.73806 34.379 5.59902 35.3593 5.35342 36.0256C5.25157 36.3819 7.84925 34.344 20.9879 34.2425C34.5345 34.09 39.2707 38.0623 39.9835 37.4001C40.3908 36.9413 41.5625 35.2103 41.0023 34.09Z" />
						<path d="M37.1816 21.7652C35.6539 18.1491 32.3942 14.279 30.2554 12.1908C26.6398 8.57468 18.6442 6.63919 19.4593 7.45436C20.885 8.87999 23.2786 11.8851 24.8065 15.094C24.8065 15.094 24.1953 15.2458 24.3992 15.6023C24.6028 16.0098 25.1119 16.2145 25.9271 16.4688C31.9362 18.4551 35.6029 21.7652 35.8575 22.0702C36.1121 22.4266 37.3854 22.2238 37.1816 21.7652ZM27.5058 14.8394C26.7926 14.533 25.8251 11.5797 21.4961 8.21818C21.0888 7.96418 27.4038 10.5615 29.0332 11.9359C31.5796 14.1765 32.7511 16.2649 34.1767 18.7095C34.1767 18.7095 32.6999 16.9275 27.5058 14.8394Z" />
					</g>
					<path class="wordmark_traco" fill-rule="evenodd" d="M9.37822 35.9742C10.3966 35.6177 19.1562 33.9876 25.8784 36.0256C26.7443 36.2797 26.4898 37.9609 25.8784 37.9609C25.0127 37.9099 23.1282 36.1779 16.3554 35.7193C13.0449 35.5156 9.63323 36.0766 9.42919 36.1267C9.22547 36.1779 9.37822 35.9742 9.37822 35.9742Z" />
				</svg>
				<span>EJFGV</span>
			</a>
			<div class="links" id="navLinks">
				{NAV.map((item) =>
					item.itens ? (
						<details class:list={['dropdown', { 'is-current': item.itens.some((f) => f.href === caminho) }]}>
							<summary>{item.rotulo}</summary>
							<ul class="dropdown-list">
								{item.itens.map((f) => (
									<li><a href={f.href} aria-current={f.href === caminho ? 'page' : undefined}>{f.rotulo}</a></li>
								))}
							</ul>
						</details>
					) : (
						<a href={item.href} aria-current={item.href === caminho ? 'page' : undefined}>{item.rotulo}</a>
					)
				)}
			</div>
			<div class="nav-actions">
				<a href={ctaHref} class="buy"><span class="buy_longo">Fale com um Especialista</span><span class="buy_curto">Fale conosco</span><svg class="buy_seta" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></a>
				<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="navLinks">Menu</button>
			</div>
		</nav>

		<main id="conteudo">
			<slot />
		</main>

		<!-- RODAPÉ INSTITUCIONAL (.footer) -->
		<footer id="footer" class="footer">
			<div class="page-padding">
				<div class="container-large">
					<div class="footer_grid">
						<div class="footer_col">
							<Image src={logoRodape} alt="Empresa Júnior FGV · Fundação Getulio Vargas" class="footer_logo" widths={[280, 560]} sizes="280px" loading="lazy" />
						</div>
						<nav class="footer_col" aria-label="Serviços">
							<p class="footer_title">Serviços</p>
							{SOLUCOES.map((s) => <a href={s.url}>{s.nome}</a>)}
						</nav>
						<nav class="footer_col" aria-label="Links rápidos">
							<p class="footer_title">Links rápidos</p>
							<a href="/sobre-nos/">Sobre</a>
							<a href="/blog/">Blog</a>
							<a href="/contato/">Contato</a>
							<a href="/politica-de-privacidade/">Política de Privacidade</a>
							<a href="/mapa-do-site/">Mapa do Site</a>
						</nav>
						<div class="footer_col">
							<p class="footer_title">Contato e redes</p>
							<a href={`mailto:${CONTATO.email}`}>{CONTATO.email}</a>
							<a href={CONTATO.whatsappUrl} target="_blank" rel="noopener">WhatsApp {CONTATO.whatsapp}</a>
							<a href={CONTATO.instagram} target="_blank" rel="noopener">Instagram</a>
							<a href={CONTATO.linkedin} target="_blank" rel="noopener">LinkedIn</a>
							<address class="footer_endereco">{CONTATO.endereco}</address>
						</div>
					</div>
					<div class="footer_bottom">
						<span>© {ano} {SITE.nome} – Todos os direitos reservados · {CONTATO.razaoSocial}</span>
						<span>Atualizado em {atualizado}</span>
					</div>
				</div>
			</div>
		</footer>

		<a class="whatsapp-float" href={CONTATO.whatsappUrl} target="_blank" rel="noopener" aria-label="Fale com a EJFGV pelo WhatsApp">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.6-5.4A8.4 8.4 0 1 1 21 11.5z"></path>
			</svg>
			<span>WhatsApp</span>
		</a>

		<!-- MODAL DE VÍDEO (Vimeo Institucional & Depoimentos) -->
		<dialog class="video-modal" id="videoModal" aria-label="Vídeo">
			<div class="video-modal_dialog">
				<button type="button" class="video-modal_close" id="closeVideoModal" aria-label="Fechar vídeo">✕</button>
				<iframe id="videoIframe" width="100%" height="100%" src="" title="Vídeo EJFGV" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
			</div>
		</dialog>

		<script src="/main.js" is:inline></script>
	</body>
</html>
