---
// Moldura comum das 5 landings de solução (fundo geral --gray50). O layout cuida só do que se repete:
// cabeçalho escuro com credenciais e logos → números → [corpo da página, slot padrão] → prova social →
// método → FAQ → formulário (serviço pré-selecionado) → outras soluções.
// O corpo (para quem é, o que entra no projeto, diferencial) é de cada página.
import Layout from './Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ImagemReservada from '../components/ImagemReservada.astro';
import StatsStrip from '../components/StatsStrip.astro';
import CaseCard from '../components/CaseCard.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Metodo from '../components/Metodo.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE, CONTATO, NUMEROS, SOLUCOES, CASES, DEPOIMENTOS, LOGOS, type Solucao, type Depoimento } from '../consts';

interface Props {
	solucao: Solucao;
	/** Abertura "resposta primeiro": 1 ou 2 frases, o que é e para quem. */
	abertura: string;
	faq: { pergunta: string; resposta?: string; validar?: boolean }[];
	/** H1 (padrão: nome da solução). */
	titulo?: string;
	kicker?: string;
	/** Descrição da foto reservada do cabeçalho. */
	fotoHeader?: string;
	depoimentos?: Depoimento[];
}

const {
	solucao,
	abertura,
	faq,
	titulo = solucao.nome,
	// Kicker não repete o H1 quando o título é o próprio nome da solução
	kicker = titulo.startsWith(solucao.nome) ? `Soluções ${SITE.nome}` : solucao.nome,
	fotoHeader = 'trabalho real em grupo',
	depoimentos = DEPOIMENTOS,
} = Astro.props;

const cases = CASES.filter((c) => solucao.cases.includes(c.slug));
const outras = SOLUCOES.filter((s) => s.slug !== solucao.slug);

// "Potência FGV" logo no topo (docx), só com fatos de consts.ts.
const credenciais = [
	`1ª Empresa Júnior da América Latina, desde ${NUMEROS.fundacao}`,
	'Orientação de professores da FGV',
	`+${NUMEROS.projetos} projetos entregues`,
];

const servico = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: solucao.nome,
	serviceType: solucao.nome,
	description: solucao.descricao,
	url: new URL(solucao.url, SITE.url).href,
	provider: { '@type': 'ProfessionalService', name: SITE.nome, url: SITE.url },
};
---

<Layout titulo={solucao.seo.titulo} descricao={solucao.seo.descricao} ctaHref="#formulario" jsonLd={servico}>
	<div class="solucao">
		<!-- 1. Cabeçalho escuro: H1, abertura curta, credenciais, CTA e logos de clientes à frente -->
		<PageHeader titulo={titulo} kicker={kicker} descricao={abertura} escuro>
			<ul class="solucao_credenciais" aria-label={`Por que a ${SITE.nome}`}>
				{credenciais.map((c) => <li>{c}</li>)}
			</ul>
			<Fragment slot="acoes">
				<a href="#formulario" class="button is-button-large">Solicite seu diagnóstico gratuito</a>
				<a href={CONTATO.whatsappUrl} class="button-tertiary" target="_blank" rel="noopener">Conversar no WhatsApp →</a>
			</Fragment>
			<figure slot="midia" class="hero-photo-frame">
				<ImagemReservada descricao={fotoHeader} classe="home-hero_image" escuro />
			</figure>
		</PageHeader>
		<div class="solucao_logos" aria-label="Empresas que já contrataram a EJFGV">
			<div class="page-padding">
				<div class="container-large">
					<p class="grandes-clientes_label">Aprovada por grandes clientes</p>
					<div class="grandes-clientes_row">
						{LOGOS.slice(0, 6).map((logo) => <img src={logo.src} alt={logo.nome} class="grandes-clientes_logo" loading="eager" />)}
					</div>
				</div>
			</div>
		</div>

		<!-- 2. Números -->
		<StatsStrip />

		<!-- 3. Corpo próprio de cada solução -->
		<slot />

		<!-- 4. Prova social -->
		<section class="section_depoimentos" aria-labelledby="prova-social-titulo">
			<div class="page-padding padding-section-medium">
				<div class="container-large">
					<div class="icp_header">
						<span class="eyebrow">{cases.length ? 'Cases de sucesso' : 'Depoimentos'}</span>
						<h2 id="prova-social-titulo">{cases.length ? 'Resultados de quem já contratou' : `O que dizem os clientes da ${SITE.nome}`}</h2>
					</div>
					{cases.length > 0 && (
						<div class="cases_grid solucao_cases">
							{cases.map((c) => (
								<CaseCard
									tag={`${c.segmento} · ${c.solucao}`}
									metrica={c.destaque}
									titulo={c.cliente}
									texto={`Desafio: ${c.problema}.`}
									href={c.url}
								/>
							))}
						</div>
					)}
					<Depoimentos itens={depoimentos} />
				</div>
			</div>
		</section>

		<!-- 5. Método -->
		<Metodo />

		<!-- 6. FAQ -->
		<Faq itens={faq} titulo={`Perguntas frequentes sobre ${solucao.nome}`} />

		<!-- 7. Formulário com o serviço pré-selecionado -->
		<LeadForm servico={solucao.slug} titulo="Agende um diagnóstico gratuito e descubra como podemos ajudar a sua empresa." />

		<!-- 8. Outras soluções -->
		<nav class="solucao_outras" aria-labelledby="outras-solucoes">
			<div class="page-padding">
				<div class="container-large">
					<h2 id="outras-solucoes" class="eyebrow">Outras soluções da {SITE.nome}</h2>
					<ul>
						{outras.map((s) => (
							<li><a href={s.url}>{s.nome} <span aria-hidden="true">→</span></a></li>
						))}
					</ul>
				</div>
			</div>
		</nav>
	</div>
</Layout>

<style>
	.solucao {
		background: var(--gray50);
	}

	.solucao :global(.section_icp),
	.solucao :global(.section_depoimentos),
	.solucao :global(.section_faq),
	.solucao :global(.section_form) {
		background: var(--gray50);
	}

	.solucao :global(.icp_item),
	.solucao :global(.faq_item) {
		background: var(--white);
	}

	.solucao :global(.section_page-header .hero_heading) {
		font-size: clamp(2.5rem, 5vw, 4.25rem);
		text-wrap: balance;
	}

	.solucao_credenciais {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
		list-style: none;
	}

	.solucao_credenciais li {
		padding: 0.4rem 0.8rem;
		color: var(--graywarm300);
		font-size: 0.85rem;
		font-weight: 600;
		border: 1px solid var(--border-hairline-dark);
		border-radius: var(--card-radius-md);
	}

	/* Logos brancos sobre o mesmo cinza do cabeçalho, como continuação dele */
	.solucao_logos {
		padding: 0 0 clamp(2rem, 4vw, 3rem);
		background: var(--graywarm900);
	}

	.solucao_logos .grandes-clientes_label {
		color: var(--graywarm300);
	}

	.solucao_logos .grandes-clientes_logo {
		filter: grayscale(1) brightness(0) invert(1);
		opacity: 0.7;
	}

	.solucao_logos .grandes-clientes_logo:hover {
		filter: grayscale(1) brightness(0) invert(1);
		opacity: 1;
	}

	.solucao_cases {
		margin-bottom: 2.5rem;
	}

	.solucao_cases :global(.case_metric) {
		font-size: clamp(1.25rem, 1.8vw, 1.5rem);
		line-height: 1.2;
	}

	.solucao_outras {
		padding: clamp(2.5rem, 5vw, 4rem) 0;
		border-top: 1px solid var(--gray200);
	}

	.solucao_outras ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1rem;
		list-style: none;
	}

	.solucao_outras a {
		display: inline-block;
		padding: 0.7rem 1.1rem;
		color: var(--gray900);
		font-weight: 700;
		background: var(--white);
		border: 1px solid var(--gray200);
		border-radius: var(--card-radius-md);
		transition: border-color 0.2s, color 0.2s;
	}

	.solucao_outras a:hover {
		color: var(--primary700);
		border-color: var(--primary600);
	}
</style>
