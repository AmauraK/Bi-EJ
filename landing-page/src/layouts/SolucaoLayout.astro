---
// Esqueleto comum das 5 landings de solução (fundo geral --gray50), na ordem do plano:
// cabeçalho escuro → credibilidade → quando contratar e benefícios → escopo → slot "especifico" →
// prova social → método → banner → FAQ → formulário (serviço pré-selecionado) → outras soluções.
import Layout from './Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ImagemReservada from '../components/ImagemReservada.astro';
import Credibilidade from '../components/Credibilidade.astro';
import StatsStrip from '../components/StatsStrip.astro';
import LogoWall from '../components/LogoWall.astro';
import CaseCard from '../components/CaseCard.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Metodo from '../components/Metodo.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE, CONTATO, NUMEROS, SOLUCOES, CASES, CITACAO_PROJETO, DEPOIMENTOS, type Solucao, type Depoimento } from '../consts';

interface Props {
	solucao: Solucao;
	/** Abertura "resposta primeiro": o que é, para quem e desde quando. */
	abertura: string;
	beneficios: { titulo: string; texto: string }[];
	faq: { pergunta: string; resposta?: string; validar?: boolean }[];
	/** H1 (padrão: nome da solução). */
	titulo?: string;
	kicker?: string;
	/** Descrição da foto reservada do cabeçalho. */
	fotoHeader?: string;
	depoimentos?: Depoimento[];
}

const {
	solucao,
	abertura,
	beneficios,
	faq,
	titulo = solucao.nome,
	kicker = `${SITE.nome} · Empresa Júnior da FGV desde ${NUMEROS.fundacao}`,
	fotoHeader = 'trabalho real em grupo',
	depoimentos = DEPOIMENTOS,
} = Astro.props;

const cases = CASES.filter((c) => solucao.cases.includes(c.slug));
const outras = SOLUCOES.filter((s) => s.slug !== solucao.slug);

const servico = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: solucao.nome,
	serviceType: solucao.nome,
	description: solucao.descricao,
	url: new URL(solucao.url, SITE.url).href,
	provider: { '@type': 'ProfessionalService', name: SITE.nome, url: SITE.url },
};
---

<Layout titulo={solucao.seo.titulo} descricao={solucao.seo.descricao} ctaHref="#formulario" jsonLd={servico}>
	<div class="solucao">
		<!-- 1. Cabeçalho escuro: H1 grande, abertura, potência FGV, CTA para o formulário e WhatsApp -->
		<PageHeader titulo={titulo} kicker={kicker} descricao={abertura} escuro>
			<p class="hero_description">
				Agora, imagine aproveitar o ecossistema da FGV e poder contar com especialistas em marketing, finanças, vendas e muito mais.
			</p>
			<Fragment slot="acoes">
				<a href="#formulario" class="button is-button-large">Fale com um Especialista</a>
				<a href={CONTATO.whatsappUrl} class="button-tertiary" target="_blank" rel="noopener">Conversar no WhatsApp →</a>
			</Fragment>
			<figure slot="midia" class="hero-photo-frame">
				<ImagemReservada descricao={fotoHeader} classe="home-hero_image" escuro />
			</figure>
		</PageHeader>

		<!-- 2. Credibilidade (Brasil Júnior logo abaixo do cabeçalho) -->
		<Credibilidade />

		<!-- 3. Quando contratar e Benefícios principais -->
		<section class="section_icp" aria-labelledby="quando-contratar">
			<div class="page-padding padding-section-medium">
				<div class="container-large">
					<div class="icp_header">
						<img src={solucao.icone} loading="lazy" alt="" class="icp_icon" />
						<span class="eyebrow">{solucao.nome}</span>
						<h2 id="quando-contratar">Quando contratar</h2>
					</div>
					<div class="icp_list">
						{solucao.quandoFazSentido.map((q) => (
							<div class="icp_item">
								<h3>{q.titulo}</h3>
								<p>{q.texto}</p>
							</div>
						))}
					</div>

					<div class="icp_header solucao_beneficios-header">
						<h2>Benefícios principais</h2>
					</div>
					<div class="cases_grid">
						{beneficios.map((b) => (
							<div class="icp_item">
								<h3>{b.titulo}</h3>
								<p>{b.texto}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- 4. Escopo com links cruzados -->
		<section id="escopo" class="section_beneficios" aria-labelledby="escopo-titulo">
			<div class="page-padding padding-section-medium">
				<div class="container-large">
					<div class="beneficios_wrapper">
						<div class="beneficios_title">
							<span class="beneficios_eyebrow">Escopo sob medida para a sua empresa</span>
							<h2 id="escopo-titulo">O que pode entrar no projeto</h2>
							<p>{solucao.descricao}</p>
						</div>
						<div class="frentes_cards-grid">
							{solucao.escopo.map((e, i) =>
								e.href ? (
									<a class="frente_mini-card" href={e.href}>
										<span>Frente {String(i + 1).padStart(2, '0')}</span>
										<h3>{e.item}</h3>
										<p>Conheça a consultoria completa →</p>
									</a>
								) : (
									<div class="frente_mini-card">
										<span>Frente {String(i + 1).padStart(2, '0')}</span>
										<h3>{e.item}</h3>
									</div>
								)
							)}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 5. Conteúdo próprio de cada solução -->
		<slot name="especifico" />

		<!-- 6. Prova social -->
		<StatsStrip />
		<LogoWall />
		<section class="section_depoimentos" aria-labelledby="prova-social-titulo">
			<div class="page-padding padding-section-medium">
				<div class="container-large">
					<div class="icp_header">
						<span class="eyebrow">Cases de sucesso</span>
						<h2 id="prova-social-titulo">Resultados de quem já contratou</h2>
					</div>
					<div class="cases_grid solucao_cases">
						{cases.length ? (
							cases.map((c) => (
								<CaseCard
									tag={`${c.segmento} · ${c.solucao}`}
									metrica={c.destaque}
									titulo={c.cliente}
									texto={`Desafio: ${c.problema}.`}
									href={c.url}
								/>
							))
						) : (
							<article class="case_card">
								<div>
									<span class="case_tag">{solucao.rotulo}</span>
									<div class="case_metric"><span class="preencher">A preencher: resultado</span></div>
								</div>
								<div>
									<h3><span class="preencher">Case de {solucao.rotulo}: a preencher</span></h3>
								</div>
							</article>
						)}
					</div>
					<Depoimentos itens={depoimentos} />
					<figure class="solucao_citacao">
						<blockquote class="depoimento_quote">“{CITACAO_PROJETO.texto}”</blockquote>
						<figcaption class="depoimento_author">
							<strong>— {CITACAO_PROJETO.autor}</strong>
							<span>{CITACAO_PROJETO.cargo}, EJFGV</span>
						</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<!-- 7. Método -->
		<Metodo />

		<!-- 8. Banner para o formulário -->
		<CtaBanner titulo={solucao.chamada} href="#formulario" rotulo="Fale com um Especialista" escuro />

		<!-- 9. FAQ -->
		<Faq itens={faq} titulo={`Perguntas frequentes sobre ${solucao.nome}`} />

		<!-- 10. Formulário com o serviço pré-selecionado -->
		<LeadForm servico={solucao.slug} titulo="Agende um diagnóstico gratuito e descubra como podemos ajudar a sua empresa." />

		<!-- 11. Outras soluções -->
		<section class="section_beneficios" aria-labelledby="outras-solucoes">
			<div class="page-padding padding-section-medium">
				<div class="container-large">
					<div class="beneficios_title">
						<h2 id="outras-solucoes">Outras soluções da EJFGV</h2>
					</div>
					<div class="frentes_cards-grid solucao_outras">
						{outras.map((s) => (
							<a class="frente_mini-card" href={s.url}>
								<span>{s.rotulo}</span>
								<h3>{s.nome}</h3>
								<p>Quero saber mais →</p>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.solucao {
		background: var(--gray50);
	}

	.solucao :global(.section_icp),
	.solucao :global(.section_depoimentos),
	.solucao :global(.section_faq),
	.solucao :global(.section_form) {
		background: var(--gray50);
	}

	.solucao :global(.icp_item),
	.solucao :global(.faq_item) {
		background: var(--white);
	}

	.solucao_beneficios-header {
		margin-top: clamp(3rem, 5vw, 4.5rem);
	}

	.solucao_cases :global(.case_metric) {
		font-size: clamp(1.25rem, 1.8vw, 1.5rem);
		line-height: 1.2;
	}

	.solucao_citacao {
		margin-top: 2.5rem;
		padding: clamp(1.75rem, 3vw, 2.5rem);
		background: var(--white);
		border: 1px solid var(--gray200);
		border-left: 4px solid var(--primary600);
		border-radius: var(--card-radius-lg);
	}

	.solucao_citacao .depoimento_quote {
		margin-bottom: 1rem;
	}

	.solucao_outras {
		margin-top: 2.5rem;
	}

	.frente_mini-card h3 {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--white);
		margin-bottom: 0.5rem;
	}
</style>
