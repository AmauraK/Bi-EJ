---
// Dobra 1 da home: "cortina" de fotos da equipe atrás do texto central (slot).
// Cada coluna é um trilho com um trecho de cada foto (convite → reunião → notebook → equipe completa),
// e os trechos de uma mesma foto se encaixam lado a lado. Ao carregar, as colunas sobem e descem em
// velocidades diferentes e param na foto da equipe completa, com o centro escurecido para o texto.
// Ao rolar (palco fixo), as colunas ondulam em parallax, o texto sai, as frestas fecham e o véu some:
// fica a foto inteira da equipe. Com prefers-reduced-motion, mostra direto o estado parado.
import { Image } from 'astro:assets';
import { FOTOS } from '../../consts';

// A última foto é onde todas as colunas param.
const PAGINAS = [FOTOS.equipeConvite, FOTOS.equipeReuniao, FOTOS.consultoresNotebook, FOTOS.equipeCompleta];

// dur/atraso: entrada; k: amplitude (px) da onda ao rolar. Celular usa as 3 primeiras, tablet as 5.
const COLUNAS = [
	{ dur: 2.7, atraso: 0.15, k: 70 },
	{ dur: 2.1, atraso: 0, k: 120 },
	{ dur: 3.0, atraso: 0.35, k: 90 },
	{ dur: 2.3, atraso: 0.05, k: 140 },
	{ dur: 2.8, atraso: 0.25, k: 80 },
	{ dur: 2.0, atraso: 0.2, k: 110 },
	{ dur: 2.5, atraso: 0.3, k: 60 },
];
---

<section class="home-cortina" aria-labelledby="page-heading">
	<div class="home-cortina_palco">
		<div class="cortina" role="img" aria-label={FOTOS.equipeCompleta.alt}>
			{COLUNAS.map((c, i) => {
				// Colunas pares sobem (trilho na ordem), ímpares descem (trilho invertido): todas mostram a mesma sequência.
				const sobe = i % 2 === 0;
				const ordem = sobe ? PAGINAS : [...PAGINAS].reverse();
				return (
					<div class:list={['cortina_col', sobe ? 'is-sobe' : 'is-desce']} style={`--i:${i};--dur:${c.dur}s;--atraso:${c.atraso}s;--k:${sobe ? c.k : -c.k}`}>
						<div class="cortina_trilho">
							{ordem.map((foto) => (
								<div class="cortina_quadro">
									<Image
										src={foto.src}
										alt=""
										widths={[640, 960, 1440, 1920]}
										sizes="(max-width: 767px) 300vw, (max-width: 1099px) 190vw, 100vw"
										quality={65}
										loading="eager"
										fetchpriority={foto === FOTOS.equipeCompleta ? 'high' : 'low'}
										decoding="async"
										style={foto.posicao ? `object-position: ${foto.posicao}` : undefined}
									/>
								</div>
							))}
						</div>
					</div>
				);
			})}
		</div>
		<div class="cortina_veu" aria-hidden="true"></div>
		<p class="cortina_legenda" aria-hidden="true"><span class="hero-photo-dot"></span>Equipe atual da EJFGV</p>
		<div class="page-padding home-cortina_conteudo">
			<div class="home-cortina_texto">
				<slot />
			</div>
		</div>
	</div>
	<script is:inline>
		// Antes da 1ª pintura: guarda as colunas fora da tela até as fotos carregarem (sem isso, fica o estado final).
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('is-entrando');
	</script>
</section>

<script>
	const secao = document.querySelector<HTMLElement>('.home-cortina.is-entrando');
	if (secao) {
		// Começa a entrada quando as fotos da 1ª coluna (as mesmas das outras) decodificam, ou em 1,5 s.
		const fotos = [...secao.querySelectorAll<HTMLImageElement>('.cortina_col:first-child img')];
		Promise.race([
			Promise.all(fotos.map((f) => f.decode().catch(() => {}))),
			new Promise((r) => setTimeout(r, 1500)),
		]).then(() => secao.classList.add('is-viva'));

		// --p: 0 no topo da seção, 1 quando o palco fixo termina; o CSS deriva tudo dele.
		let agendado = false;
		const atualizar = () => {
			agendado = false;
			const r = secao.getBoundingClientRect();
			const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
			secao.style.setProperty('--p', p.toFixed(4));
			secao.classList.toggle('is-revelada', p > 0.4);
		};
		addEventListener('scroll', () => {
			if (!agendado) {
				agendado = true;
				requestAnimationFrame(atualizar);
			}
		}, { passive: true });
		atualizar();
	}
</script>

<style>
	.home-cortina {
		--p: 0;
		position: relative;
		background-color: var(--graywarm900);
		color: var(--white);
	}

	/* O palco fixo só existe com movimento: 75svh de rolagem para a cortina se fechar na foto */
	.home-cortina.is-entrando {
		height: 175svh;
	}

	.home-cortina_palco {
		position: relative;
		min-height: 100svh;
		display: grid;
		align-items: center;
		overflow: hidden;
	}

	.is-entrando .home-cortina_palco {
		position: sticky;
		top: 0;
		height: 100svh;
	}

	/* Colunas; as frestas só fecham no último quarto da rolagem */
	.cortina {
		--n: 7;
		--gap: calc(4px * clamp(0, (1 - var(--p)) * 4, 1));
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(var(--n), 1fr);
		gap: var(--gap);
	}

	.cortina_col {
		position: relative;
		overflow: hidden;
		container-type: size;
	}

	.cortina_trilho {
		translate: 0 var(--fim);
		transform: translateY(calc(var(--k) * var(--p) * (1 - var(--p)) * 4px));
		will-change: translate, transform;
	}

	/* 4 quadros: quem sobe para no último, quem desce para no primeiro (trilho invertido) */
	.is-sobe .cortina_trilho {
		--inicio: 100cqh;
		--fim: calc(-3 * 100cqh);
	}

	.is-desce .cortina_trilho {
		--inicio: calc(-4 * 100cqh);
		--fim: 0px;
	}

	.is-entrando .cortina_trilho {
		translate: 0 var(--inicio);
	}

	.is-entrando.is-viva .cortina_trilho {
		animation: cortina-entra var(--dur) var(--atraso) cubic-bezier(0.45, 0, 0.15, 1) both;
	}

	@keyframes cortina-entra {
		from { translate: 0 var(--inicio); }
		to { translate: 0 var(--fim); }
	}

	/* Cada quadro mostra o trecho da coluna --i de uma foto do tamanho do palco */
	.cortina_quadro {
		position: relative;
		height: 100cqh;
		overflow: hidden;
	}

	.cortina_quadro img {
		position: absolute;
		top: 0;
		left: calc(var(--i) * -1 * (100cqw + var(--gap)));
		width: calc(var(--n) * 100cqw + (var(--n) - 1) * var(--gap));
		max-width: none;
		height: 100%;
		object-fit: cover;
	}

	/* Centro escuro para o texto, pessoas visíveis nas bordas; some ao rolar */
	.cortina_veu {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(ellipse 46% 58% at 50% 52%, rgba(24, 24, 22, 0.9) 0%, rgba(24, 24, 22, 0.84) 55%, rgba(24, 24, 22, 0) 100%),
			linear-gradient(rgba(24, 24, 22, 0.34), rgba(24, 24, 22, 0.26));
		opacity: calc(1 - var(--p));
	}

	.cortina_legenda {
		position: absolute;
		left: clamp(1.25rem, 4vw, 3.5rem);
		bottom: 1.5rem;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		padding: 0.5rem 0.9rem;
		border-radius: var(--card-radius-md);
		background: rgba(24, 24, 22, 0.72);
		font-size: 0.875rem;
		font-weight: 600;
		opacity: clamp(0, (var(--p) - 0.8) * 5, 1);
	}

	.home-cortina_conteudo {
		position: relative;
		z-index: 2;
		padding-top: calc(var(--nav-height) + 1.5rem);
		padding-bottom: 1.5rem;
	}

	.home-cortina_texto {
		max-width: 56rem;
		margin: 0 auto;
		text-align: center;
		opacity: clamp(0, 1 - var(--p) * 2.5, 1);
		transform: translateY(calc(var(--p) * -90px));
	}

	.is-revelada .home-cortina_texto {
		visibility: hidden;
	}

	/* Texto do slot sobre o fundo escuro */
	.home-cortina .home-cortina_texto :global(.home-hero_divider) {
		margin-left: auto;
		margin-right: auto;
	}

	.home-cortina .home-cortina_texto :global(.hero_kicker) {
		color: var(--text-eyebrow-dark);
		background: rgba(249, 255, 252, 0.08);
		border-color: rgba(249, 255, 252, 0.2);
	}

	.home-cortina .home-cortina_texto :global(.hero_heading) {
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		line-height: 1.08;
		color: var(--white);
		text-wrap: balance;
	}

	.home-cortina .home-cortina_texto :global(.hero_description) {
		max-width: 62ch;
		margin-left: auto;
		margin-right: auto;
		color: var(--graywarm300);
	}

	.home-cortina .home-cortina_texto :global(.hero_actions) {
		justify-content: center;
		margin-bottom: 0;
	}

	.home-cortina .home-cortina_texto :global(.button-secondary) {
		background-color: transparent;
		border-color: rgba(249, 255, 252, 0.6);
		color: var(--white);
	}

	.home-cortina .home-cortina_texto :global(.button-secondary:hover) {
		background-color: rgba(249, 255, 252, 0.1);
		border-color: var(--white);
	}

	/* Tablet: 5 colunas; celular: 3 (o resto some) */
	@media (max-width: 1099px) {
		.cortina { --n: 5; }
		.cortina_col:nth-child(n + 6) { display: none; }
	}

	@media (max-width: 767px) {
		.cortina { --n: 3; }
		.cortina_col:nth-child(n + 4) { display: none; }

		.cortina_veu {
			background: linear-gradient(rgba(24, 24, 22, 0.74), rgba(24, 24, 22, 0.86) 30%, rgba(24, 24, 22, 0.86) 75%, rgba(24, 24, 22, 0.6));
		}

		.home-cortina .home-cortina_texto :global(.hero_heading) {
			font-size: 2rem;
		}
	}
</style>
