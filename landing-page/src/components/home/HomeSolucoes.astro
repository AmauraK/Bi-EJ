---
import { SITE, SOLUCOES } from '../../consts';
import ImagemReservada from '../ImagemReservada.astro';
---

<section class="section_beneficios padding-section-medium" id="solucoes">
  <div class="page-padding">
    <div class="container-large">
      <div class="beneficios_wrapper" data-solucoes-tabs>
        <div class="beneficios_title">
          <span class="beneficios_eyebrow">Nossas 5 Frentes de Atuação</span>
          <h2>Soluções sob medida para cada desafio da sua empresa</h2>
          <p>
            Selecione uma área abaixo para explorar quando contratar, o escopo detalhado das entregas e como os consultores da Fundação Getulio Vargas estruturam cada projeto.
          </p>
        </div>

        <div
          class="frentes_tabs"
          role="tablist"
          aria-label="Frentes de consultoria da EJFGV"
        >
          {SOLUCOES.map((solucao, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${solucao.slug}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`panel-${solucao.slug}`}
              tabindex={index === 0 ? 0 : -1}
              class:list={['frente_tab', { 'is-active': index === 0 }]}
              data-solucao-tab={index}
            >
              {solucao.nome}
            </button>
          ))}
        </div>

        <noscript>
          <style>
            .solucao_panel[hidden] {
              display: grid !important;
              margin-top: 2.5rem;
              padding-top: 2.5rem;
              border-top: 1px solid var(--border-hairline-dark);
            }
          </style>
        </noscript>

        <div class="solucoes_panels">
          {SOLUCOES.map((solucao, index) => (
            <div
              role="tabpanel"
              id={`panel-${solucao.slug}`}
              aria-labelledby={`tab-${solucao.slug}`}
              tabindex="0"
              class="beneficios_item solucao_panel"
              data-solucao-panel={index}
              hidden={index !== 0 ? true : undefined}
            >
              <div class="solucao_panel-left">
                <div class="solucao_panel-head">
                  <img
                    src={solucao.icone}
                    alt={`Ícone de ${solucao.nome}`}
                    class="vantagens_icon"
                    loading="lazy"
                  />
                  <div>
                    <span class="beneficios_eyebrow">{solucao.categoria}</span>
                    <h3>{solucao.nome}</h3>
                  </div>
                </div>

                <p class="solucao_panel-lead">{solucao.lead}</p>
                <p class="solucao_panel-desc">{solucao.descricao}</p>

                <div class="solucao_quando-block">
                  <h4 class="solucao_subhead">Quando contratar</h4>
                  <div class="solucao_quando-grid">
                    {solucao.quandoFazSentido.map((q) => (
                      <div class="solucao_quando-card">
                        <strong>{q.titulo}</strong>
                        <p>{q.texto}</p>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="solucao_panel-actions">
                  <a href={solucao.url} class="button">
                    Quero saber mais
                  </a>
                  <a href="#formulario" class="button-secondary solucao_btn-form">
                    Solicitar diagnóstico gratuito
                  </a>
                </div>
              </div>

              <div class="solucao_panel-right">
                <div class="solucao_escopo-box">
                  <h4 class="solucao_subhead">Escopo e principais entregas</h4>
                  <ul class="vantagens_list">
                    {solucao.escopo.map((item) => (
                      <li class="vantagens_list-item">
                        <img
                          src={SITE.iconeCheck}
                          alt="Item incluído no escopo"
                          loading="lazy"
                        />
                        <div>
                          {item.href ? (
                            <a href={item.href} class="solucao_escopo-link">
                              <strong>{item.nome}</strong>
                              <span aria-hidden="true">↗</span>
                            </a>
                          ) : (
                            <strong class="solucao_escopo-title">{item.nome}</strong>
                          )}
                          {item.descricao && (
                            <p class="solucao_escopo-desc">{item.descricao}</p>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>

                <ImagemReservada
                  rotulo={`Sessão de trabalho e entregas reais de ${solucao.nome} — equipe EJFGV`}
                  proporcao="16/9"
                  escura={true}
                />
              </div>
            </div>
          ))}
        </div>

        <div class="solucoes_all-access" aria-label="Acesso direto a todas as 5 soluções">
          <p class="solucoes_all-label">
            Visão rápida de todas as 5 frentes de consultoria (acesso direto):
          </p>
          <div class="frentes_cards-grid home-frentes_grid-5">
            {SOLUCOES.map((s) => (
              <a href={s.url} class="frente_mini-card">
                <span>{s.nomeCurto}</span>
                <h4>{s.nome}</h4>
                <p>{s.desafio}</p>
                <strong class="frente_mini-link">Quero saber mais →</strong>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-solucoes-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-solucao-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-solucao-panel]'));
    if (tabs.length === 0 || panels.length === 0) return;

    function activateTab(targetIndex: number, focusTab = false) {
      tabs.forEach((tab, idx) => {
        const isActive = idx === targetIndex;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
        if (isActive && focusTab) {
          tab.focus();
        }
      });

      panels.forEach((panel, idx) => {
        if (idx === targetIndex) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        activateTab(index, false);
      });

      tab.addEventListener('keydown', (event) => {
        const total = tabs.length;
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          activateTab((index + 1) % total, true);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          activateTab((index - 1 + total) % total, true);
        } else if (event.key === 'Home') {
          event.preventDefault();
          activateTab(0, true);
        } else if (event.key === 'End') {
          event.preventDefault();
          activateTab(total - 1, true);
        }
      });
    });
  });
</script>

<style>
  .solucao_panel {
    align-items: start;
  }

  .solucao_panel-left {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .solucao_panel-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .solucao_panel-head .vantagens_icon {
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .solucao_panel-head .beneficios_eyebrow {
    margin-bottom: 0.25rem;
  }

  .solucao_panel-head h3 {
    margin-bottom: 0;
  }

  .solucao_panel-lead {
    font-size: 1.075rem;
    font-weight: 700;
    color: var(--white);
  }

  .solucao_panel-desc {
    color: var(--graywarm300);
  }

  .solucao_subhead {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary200);
    margin-bottom: 0.85rem;
  }

  .solucao_quando-block {
    margin-top: 0.35rem;
  }

  .solucao_quando-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .solucao_quando-card {
    background: var(--graywarm950);
    border: 1px solid var(--border-hairline-dark);
    border-radius: var(--card-radius-md);
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .solucao_quando-card strong {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--white);
  }

  .solucao_quando-card p {
    font-size: 0.875rem;
    color: var(--graywarm300);
    line-height: 1.55;
  }

  .solucao_panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .solucao_btn-form {
    border-color: var(--border-hairline-dark);
  }

  .solucao_panel-right {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .solucao_escopo-box {
    background: var(--graywarm950);
    border: 1px solid var(--border-hairline-dark);
    border-radius: var(--card-radius-lg);
    padding: 1.5rem;
  }

  .solucao_escopo-box .vantagens_list {
    margin-top: 0;
  }

  .solucao_escopo-title {
    display: block;
    color: var(--white);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .solucao_escopo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--primary200);
    font-size: 0.95rem;
    margin-bottom: 0.15rem;
    text-decoration: underline;
  }

  .solucao_escopo-link:hover {
    color: var(--white);
  }

  .solucao_escopo-desc {
    font-size: 0.84rem;
    color: var(--graywarm300);
    line-height: 1.45;
  }

  .solucoes_all-access {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-hairline-dark);
  }

  .solucoes_all-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--graywarm300);
    margin-bottom: 1rem;
  }

  .home-frentes_grid-5 {
    grid-template-columns: repeat(5, 1fr);
    padding-top: 0;
    border-top: none;
  }

  .frente_mini-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .frente_mini-link {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary200);
  }

  @media (max-width: 1024px) {
    .home-frentes_grid-5 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .home-frentes_grid-5 {
      grid-template-columns: 1fr;
    }

    .solucao_panel-actions {
      flex-direction: column;
    }

    .solucao_panel-actions a {
      width: 100%;
    }
  }
</style>
