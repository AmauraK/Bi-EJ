---
import { CASES, NUMEROS } from '../../consts';

const destaquesResultados = [
  CASES[0], // Ma Cerise
  CASES[6], // Espaço de Eventos em SP
  CASES[5], // Investidores do Agronegócio (Café)
  CASES[7], // Menezes e Emídio Advogados
  CASES[4], // Agência Comunik
  CASES[3], // Rica Vida
].filter(Boolean);
---

<section class="section_resultados-cases padding-section-medium" id="resultados">
  <div class="page-padding">
    <div class="container-large">
      <div class="resultados-cases_header">
        <div class="metodo_icon resultados-cases_badge-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M18 20V10M12 20V4M6 20v-6" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <span class="eyebrow">Impacto Real nos Negócios</span>
        <h2>Resultados concretos construídos em {NUMEROS.projetosFormatado} projetos</h2>
        <p>
          Cada diagnóstico e entrega da EJFGV é desenhado para sair do papel: da validação financeira que evita prejuízos milionários à estruturação comercial e operacional que multiplica resultados.
        </p>
      </div>

      <div class="resultados-cases_grid">
        {destaquesResultados.map((item, idx) => (
          <article class="resultados-cases_card">
            <div class="resultados-cases_card-top">
              <div class="metodo_icon" aria-hidden="true">
                {idx % 3 === 0 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M23 6l-9.5 9.5-5-5L1 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M17 6h6v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {idx % 3 === 1 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {idx % 3 === 2 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                    <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </div>
              <span class="case_tag">{item.segmento} · {item.cliente}</span>
            </div>

            <div class="case_metric">{item.metricaCurta}</div>
            <h3>{item.destaque}</h3>
            <p>
              <strong>Entrega realizada:</strong> {item.solucao} — {item.resultadosTexto[0]}
            </p>
            {item.notaConfirmar && (
              <p>
                <span class="preencher">{item.notaConfirmar}</span>
              </p>
            )}
            <a href={item.url} class="resultados-cases_link">
              Ver detalhes do projeto →
            </a>
          </article>
        ))}
      </div>

      <div class="resultados-cases_cta">
        <a href="#formulario" class="button is-button-large">
          Solicite seu diagnóstico gratuito
        </a>
        <a href="/cases-de-sucesso/" class="button-secondary is-button-large">
          Explorar todos os cases de sucesso
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section_resultados-cases {
    background: var(--gray50);
    border-top: 1px solid var(--gray200);
    border-bottom: 1px solid var(--gray200);
  }

  .resultados-cases_header {
    text-align: center;
    max-width: 46rem;
    margin: 0 auto 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .resultados-cases_badge-icon {
    margin-bottom: 0.85rem;
  }

  .resultados-cases_header h2 {
    font-size: clamp(1.65rem, 2.5vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--gray900);
    margin-bottom: 0.75rem;
  }

  .resultados-cases_header p {
    font-size: 1rem;
    color: var(--gray600);
    line-height: 1.6;
  }

  .resultados-cases_grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .resultados-cases_card {
    background: var(--white);
    border: 1px solid var(--gray200);
    border-radius: var(--card-radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .resultados-cases_card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .resultados-cases_card-top .metodo_icon,
  .resultados-cases_card-top .case_tag {
    margin-bottom: 0;
  }

  .resultados-cases_card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--gray900);
    line-height: 1.35;
  }

  .resultados-cases_card p {
    font-size: 0.88rem;
    color: var(--gray600);
    line-height: 1.55;
  }

  .resultados-cases_link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary700);
    margin-top: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .resultados-cases_link:hover {
    color: var(--primary600);
  }

  .resultados-cases_cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
  }

  @media (max-width: 1024px) {
    .resultados-cases_grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .resultados-cases_grid {
      grid-template-columns: 1fr;
    }

    .resultados-cases_cta {
      flex-direction: column;
    }

    .resultados-cases_cta a {
      width: 100%;
    }
  }
</style>
