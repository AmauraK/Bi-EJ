---
// Fundo da dobra 1 da home: um mosaico vivo de ladrilhos com fotos reais da equipe. A foto da equipe na escadaria
// aparece já na 1ª pintura; na abertura, uma onda que parte do centro dá uma volta completa em 3D em cada ladrilho
// (no meio da volta aparece uma miniatura de outro momento da equipe) e devolve a foto inteira. A volta é uma única
// animação CSS de transform, que roda no compositor e não depende do JS durante o movimento. A cada ~6 s uma onda vira o mosaico para outra foto (reunião, auditório) e volta;
// o mouse vira um ladrilho e mostra, inteira, outra foto da equipe. Sem JS, com movimento reduzido ou com economia de
// dados: só a foto, parada. Imagens decodificadas antes da onda e verso pintado em tempo ocioso, para a onda não travar.
import { Image, getImage } from 'astro:assets';
import { FOTOS, type Foto as TipoFoto } from '../../consts';

// "center 55%" → [0.5, 0.55]: o mesmo foco do object-position, usado no recorte de cada ladrilho
const foco = (posicao = 'center center') =>
	posicao.split(' ').map((p) => (p.endsWith('%') ? parseFloat(p) / 100 : ({ left: 0, top: 0, right: 1, bottom: 1 } as Record<string, number>)[p] ?? 0.5));

const quadro = async (foto: TipoFoto, legenda: string, comImagem = true) => ({
	src: comImagem ? (await getImage({ src: foto.src, width: 1600, quality: 60, format: 'webp' })).src : '',
	srcPequena: comImagem ? (await getImage({ src: foto.src, width: 900, quality: 60, format: 'webp' })).src : '',
	w: foto.src.width,
	h: foto.src.height,
	foco: foco(foto.posicao),
	legenda,
});

const principal = FOTOS.equipeCompleta;
// A principal usa o src que o navegador já escolheu no <img> (currentSrc), sem baixar de novo.
const quadros = [
	await quadro(principal, 'A equipe EJFGV', false),
	await quadro(FOTOS.equipeReuniao, 'Em reunião de projeto'),
	await quadro(FOTOS.equipeAuditorio, 'No auditório'),
];

// Miniaturas inteiras de outros momentos da equipe: o retalho de que a foto grande se forma na abertura
const miniaturas = await Promise.all(
	[FOTOS.equipeEscadaria, FOTOS.equipeConvite, FOTOS.consultoresNotebook, FOTOS.consultorasDocumento, FOTOS.equipeAuditorio, FOTOS.equipeReuniao].map(
		async (f) => ({ src: (await getImage({ src: f.src, width: 360, quality: 60, format: 'webp' })).src, posicao: f.posicao ?? 'center' }),
	),
);
---

<div class="mosaico" data-mosaico data-quadros={JSON.stringify(quadros)} data-miniaturas={JSON.stringify(miniaturas)}>
	<Image
		src={principal.src}
		alt={principal.alt}
		class="mosaico_foto"
		widths={[600, 900, 1280, 1600]}
		quality={60}
		width={1600}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
		style={`object-position: ${principal.posicao}`}
	/>
	<div class="mosaico_grade" aria-hidden="true"></div>
	<div class="mosaico_veu" aria-hidden="true"></div>
	<p class="mosaico_legenda" aria-hidden="true">{quadros[0].legenda}</p>
</div>
<script is:inline>
	// Antes da 1ª pintura: marca o mosaico como vivo (a foto continua à mostra até o mosaico assumir). Se o script
	// do mosaico não rodar em 6 s de aba visível, volta ao modo parado (aba aberta em segundo plano não conta).
	(() => {
		const raiz = document.querySelector('[data-mosaico]');
		if (!raiz || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		raiz.classList.add('is-vivo');
		let visivelMs = 0;
		const conferir = () => {
			if (raiz.classList.contains('is-pronto')) return;
			if (!document.hidden) visivelMs += 1000;
			if (visivelMs >= 6000) raiz.classList.remove('is-vivo');
			else setTimeout(conferir, 1000);
		};
		setTimeout(conferir, 1000);
	})();
</script>

<script>
	type Quadro = { src: string; srcPequena: string; w: number; h: number; foco: number[]; legenda: string };
	type Miniatura = { src: string; posicao: string };
	type Ladrilho = { el: HTMLElement; carta: HTMLElement; frente: HTMLElement; verso: HTMLElement; c: number; r: number; detalhe: boolean; naFrente: boolean };

	const raiz = document.querySelector<HTMLElement>('[data-mosaico]');
	const economia = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
	if (raiz?.classList.contains('is-vivo') && economia) raiz.classList.remove('is-vivo');
	if (raiz?.classList.contains('is-vivo')) {
		const grade = raiz.querySelector<HTMLElement>('.mosaico_grade')!;
		const foto = raiz.querySelector<HTMLImageElement>('.mosaico_foto')!;
		const legenda = raiz.querySelector<HTMLElement>('.mosaico_legenda')!;
		const [principal, ...outras] = JSON.parse(raiz.dataset.quadros!) as Quadro[];
		const miniaturas = JSON.parse(raiz.dataset.miniaturas!) as Miniatura[];
		const pequena = innerWidth * devicePixelRatio < 1000;
		for (const q of outras) q.src = pequena ? q.srcPequena : q.src;

		const PAUSA = 6000;
		const ABERTURA = 1200; // volta de cada ladrilho na abertura
		const ONDA_ABERTURA = 1200; // atraso máximo, do centro para as bordas
		const EXIBICAO = 3200;
		const ONDA = 1100;
		const VIRADA = 900;
		const LADO = matchMedia('(max-width: 767px)').matches ? 90 : 150;
		const espera = (ms: number) => new Promise((ok) => setTimeout(ok, ms));
		const ocioso = (fn: () => void) =>
			'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 200);
		const quadroSeguinte = () => new Promise<void>((ok) => requestAnimationFrame(() => ok()));

		const carregar = (src: string) =>
			new Promise<boolean>((ok) => {
				const img = new Image();
				img.decoding = 'async';
				img.src = src;
				img.decode().then(() => ok(true), () => ok(false));
			});

		const prontas: Miniatura[] = [];
		const minisCarregando = Promise.all(miniaturas.map(async (m) => (await carregar(m.src)) && prontas.push(m)));
		const decodificadas = new Set<string>();
		const garantir = async (q: Quadro) => {
			if (decodificadas.has(q.src)) return true;
			const ok = await carregar(q.src);
			if (ok) decodificadas.add(q.src);
			return ok;
		};

		let ladrilhos: Ladrilho[] = [];
		let cols = 0, rows = 0, W = 0, H = 0;
		let timer = 0, vez = 0, sobre = 0, emOnda = false, visivel = true, versoPronto = '';
		let fase: 'principal' | 'transicao' | 'outra' = 'principal';

		const cobrir = (q: Quadro) => {
			const s = Math.max(W / q.w, H / q.h);
			const bw = q.w * s, bh = q.h * s;
			return { bw, bh, ox: (W - bw) * q.foco[0], oy: (H - bh) * q.foco[1] };
		};
		const pintar = (face: HTMLElement, q: Quadro, t: Ladrilho) => {
			const { bw, bh, ox, oy } = cobrir(q);
			face.style.backgroundImage = `url("${q.src}")`;
			face.style.backgroundSize = `${bw}px ${bh}px`;
			face.style.backgroundPosition = `${ox - t.c * (W / cols) - 1}px ${oy - t.r * (H / rows) - 1}px`;
		};
		const pintarMiniatura = (face: HTMLElement, t: Ladrilho, i: number) => {
			const m = prontas[i % prontas.length];
			if (!m) return pintar(face, principal, t);
			face.style.backgroundImage = `url("${m.src}")`;
			face.style.backgroundSize = 'cover';
			face.style.backgroundPosition = m.posicao;
		};
		const virar = (t: Ladrilho, virada: boolean, atraso = 0) => {
			t.el.style.setProperty('--d', `${Math.round(atraso)}ms`);
			t.carta.classList.toggle('is-virada', virada);
		};
		const animando = (ms: number) => {
			raiz.classList.add('is-animando');
			clearTimeout(animandoTimer);
			animandoTimer = window.setTimeout(() => raiz.classList.remove('is-animando'), ms);
		};
		let animandoTimer = 0;
		let aberturaTimer = 0;

		// Mouse: com a equipe à mostra, o ladrilho vira para o verso (miniatura); com outra foto à mostra
		// (depois de uma onda), vira de volta para a frente, que recebe a miniatura e depois volta à equipe.
		const entrar = (t: Ladrilho) => {
			if (fase === 'transicao' || t.detalhe) return;
			t.detalhe = true;
			sobre++;
			t.naFrente = fase === 'outra';
			if (t.naFrente) pintarMiniatura(t.frente, t, t.c + t.r);
			else {
				versoPronto = '';
				pintarMiniatura(t.verso, t, t.c + t.r);
			}
			t.el.classList.add('is-detalhe');
			animando(VIRADA + 100);
			virar(t, !t.naFrente);
		};
		const sair = (t: Ladrilho) => {
			if (!t.detalhe) return;
			t.detalhe = false;
			sobre--;
			t.el.classList.remove('is-detalhe');
			animando(VIRADA + 100);
			virar(t, t.naFrente);
			if (t.naFrente) setTimeout(() => t.detalhe || pintar(t.frente, principal, t), VIRADA);
		};
		const soltarMouse = () => {
			for (const t of ladrilhos) {
				if (!t.detalhe) continue;
				t.detalhe = false;
				t.el.classList.remove('is-detalhe');
				if (t.naFrente) pintar(t.frente, principal, t);
			}
			sobre = 0;
		};

		const montar = () => {
			W = grade.clientWidth;
			H = grade.clientHeight;
			cols = Math.max(5, Math.round(W / LADO));
			rows = Math.max(3, Math.round(H / (W / cols)));
			const tw = W / cols, th = H / rows;
			const passar = matchMedia('(hover: hover) and (pointer: fine)').matches;
			const fragmento = document.createDocumentFragment();
			ladrilhos = [];
			versoPronto = '';
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					const el = document.createElement('div');
					el.className = 'mosaico_ladrilho';
					el.style.cssText = `width:${tw}px;height:${th}px`;
					el.style.setProperty('--x', `${c * tw}px`);
					el.style.setProperty('--y', `${r * th}px`);
					el.innerHTML = '<div class="mosaico_carta"><i></i><i></i></div>';
					const carta = el.firstElementChild as HTMLElement;
					const [frente, verso] = Array.from(carta.children) as HTMLElement[];
					const t = { el, carta, frente, verso, c, r, detalhe: false, naFrente: false };
					pintar(frente, principal, t);
					if (passar) {
						el.addEventListener('pointerenter', () => entrar(t));
						el.addEventListener('pointerleave', () => sair(t));
					}
					ladrilhos.push(t);
					fragmento.append(el);
				}
			}
			grade.replaceChildren(fragmento);
		};

		const agendar = (ms: number) => {
			clearTimeout(timer);
			timer = window.setTimeout(onda, ms);
		};

		const prepararVerso = (q: Quadro) => {
			if (versoPronto === q.src) return;
			ocioso(() => {
				if (fase !== 'principal' || sobre > 0) return;
				for (const t of ladrilhos) pintar(t.verso, q, t);
				versoPronto = q.src;
			});
		};

		const onda = async () => {
			if (!outras.length) return;
			if (!visivel || document.hidden || sobre > 0) return agendar(1500);
			const q = outras[vez % outras.length];
			if (!(await garantir(q))) {
				outras.splice(outras.indexOf(q), 1);
				return agendar(PAUSA);
			}
			const daDireita = vez++ % 2 === 1;
			const atraso = (t: Ladrilho) => (((daDireita ? cols - 1 - t.c : t.c) / cols + t.r / rows) / 2) * ONDA;
			emOnda = true;
			fase = 'transicao';
			if (versoPronto !== q.src) {
				for (const t of ladrilhos) pintar(t.verso, q, t);
				versoPronto = q.src;
				await quadroSeguinte();
			}
			await quadroSeguinte();
			animando(ONDA + VIRADA + 100);
			for (const t of ladrilhos) virar(t, true, atraso(t));
			legenda.classList.add('is-trocando');
			await espera(ONDA / 2);
			legenda.textContent = q.legenda;
			legenda.classList.remove('is-trocando');
			await espera(ONDA / 2 + VIRADA);
			fase = 'outra';
			timer = window.setTimeout(async () => {
				for (let i = 0; sobre > 0 && i < 20; i++) await espera(500);
				fase = 'transicao';
				soltarMouse();
				await quadroSeguinte();
				animando(ONDA + VIRADA + 100);
				for (const t of ladrilhos) virar(t, false, atraso(t));
				legenda.classList.add('is-trocando');
				await espera(ONDA / 2);
				legenda.textContent = principal.legenda;
				legenda.classList.remove('is-trocando');
				await espera(ONDA + VIRADA / 2);
				emOnda = false;
				fase = 'principal';
				versoPronto = '';
				const proxima = outras[vez % outras.length];
				if (proxima) garantir(proxima).then((ok) => ok && prepararVerso(proxima));
				agendar(PAUSA);
			}, EXIBICAO);
		};

		// Abertura: a grade entra idêntica à foto (troca invisível); dois quadros depois, para o navegador já ter
		// pintado frente e verso, a onda começa. Nenhum verso é repintado enquanto a onda corre.
		const abrir = () => {
			fase = 'transicao';
			for (const t of ladrilhos) {
				pintarMiniatura(t.verso, t, t.c + t.r * 2);
				const dist = Math.hypot((t.c + 0.5) / cols - 0.5, (t.r + 0.5) / rows - 0.5) / 0.71;
				t.el.style.setProperty('--d', `${Math.round(dist * ONDA_ABERTURA + Math.random() * 120)}ms`);
			}
			raiz.classList.add('is-pronto');
			// Espera a página sossegar (load + um momento ocioso, no máximo 2,5 s): com a foto já à mostra, esperar
			// não custa nada, e a onda não disputa o processador com o resto do carregamento.
			const carregada = new Promise<void>((ok) =>
				document.readyState === 'complete' ? ok() : addEventListener('load', () => ok(), { once: true }),
			);
			Promise.race([carregada.then(() => new Promise<void>((ok) => ocioso(() => ok()))), espera(2500)]).then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
				animando(ABERTURA + ONDA_ABERTURA + 300);
				raiz.classList.add('is-abrindo');
				aberturaTimer = window.setTimeout(() => {
					raiz.classList.remove('is-abrindo');
					raiz.classList.add('is-montado');
					fase = 'principal';
					versoPronto = '';
					ocioso(async () => {
						const primeira = outras[0];
						if (primeira && (await garantir(primeira))) prepararVerso(primeira);
					});
					agendar(PAUSA);
				}, ABERTURA + ONDA_ABERTURA + 200);
			})));
		};

		new IntersectionObserver(([e]) => (visivel = e.isIntersecting)).observe(raiz);
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden && !emOnda) agendar(PAUSA);
		});

		let redim = 0;
		new ResizeObserver(() => {
			if (!raiz.classList.contains('is-pronto') || (grade.clientWidth === W && grade.clientHeight === H)) return;
			clearTimeout(redim);
			redim = window.setTimeout(() => {
				clearTimeout(timer);
				clearTimeout(aberturaTimer);
				raiz.classList.remove('is-abrindo');
				raiz.classList.add('is-montado');
				emOnda = false;
				fase = 'principal';
				sobre = 0;
				legenda.textContent = principal.legenda;
				montar();
				agendar(PAUSA);
			}, 250);
		}).observe(grade);

		const fotoPronta = foto.decode().catch(() => undefined).then(() => {
			principal.src = foto.currentSrc || foto.src;
		});
		Promise.race([Promise.all([fotoPronta, minisCarregando]), espera(2500)]).then(async () => {
			await fotoPronta;
			montar();
			abrir();
		});
	}
</script>

<style>
	.mosaico {
		position: absolute;
		inset: var(--nav-height) 0 0;
		z-index: 1;
		overflow: hidden;
		background: var(--graywarm950);
	}

	.mosaico_foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.8s ease;
	}

	/* A grade entra sem transição: na abertura ela é idêntica à foto. Depois da abertura a foto sai devagar,
	   e as juntas da grade aparecem aos poucos. */
	.mosaico_grade {
		position: absolute;
		inset: 0;
		opacity: 0;
	}

	.mosaico.is-montado .mosaico_foto {
		opacity: 0;
	}

	.mosaico.is-pronto .mosaico_grade {
		opacity: 1;
	}

	.mosaico_grade :global(.mosaico_ladrilho) {
		position: absolute;
		top: 0;
		left: 0;
		contain: layout style;
		transform: translate3d(var(--x), var(--y), 0);
		transition: transform 1.1s cubic-bezier(0.22, 0.75, 0.2, 1) var(--d, 0ms);
	}

	/* Abertura: cada carta dá uma volta inteira (frente → miniatura → frente) e encolhe um pouco no meio dela.
	   Uma só animação de transform por ladrilho, sem variáveis nos keyframes: o compositor cuida de tudo. */
	.mosaico.is-abrindo :global(.mosaico_carta) {
		animation: mosaico-volta 1.2s cubic-bezier(0.45, 0, 0.25, 1) var(--d, 0ms) both;
	}

	@keyframes mosaico-volta {
		0% { transform: perspective(800px) rotateY(0deg) scale(1); }
		50% { transform: perspective(800px) rotateY(180deg) scale(0.88); }
		100% { transform: perspective(800px) rotateY(360deg) scale(1); }
	}

	.mosaico.is-animando :global(.mosaico_carta) {
		will-change: transform;
	}

	.mosaico_grade :global(.mosaico_carta) {
		position: absolute;
		inset: 0;
		transform: perspective(800px) rotateY(0deg);
		transform-style: preserve-3d;
		transition: transform 0.9s cubic-bezier(0.3, 0.6, 0.2, 1) var(--d, 0ms);
	}

	.mosaico_grade :global(.mosaico_carta.is-virada) {
		transform: perspective(800px) rotateY(180deg);
	}

	.mosaico_grade :global(.mosaico_carta i) {
		position: absolute;
		inset: 1px;
		border-radius: 3px;
		/* Transparente: enquanto a imagem de um ladrilho não foi pintada, aparece o que está atrás (a foto, na
		   abertura) em vez de um quadrado cinza */
		background-color: transparent;
		background-repeat: no-repeat;
		backface-visibility: hidden;
	}

	.mosaico_grade :global(.mosaico_carta i + i) {
		transform: rotateY(180deg);
	}

	/* Ladrilho virado pelo mouse: sai do plano e compensa o véu, para o detalhe aparecer */
	.mosaico_grade :global(.mosaico_ladrilho.is-detalhe) {
		z-index: 1;
		transform: translate3d(var(--x), var(--y), 0) scale(1.08);
	}

	.mosaico_grade :global(.is-detalhe .mosaico_carta i) {
		box-shadow: 0 0 0 2px var(--primary600);
	}

	/* Centro escurecido para o texto (contraste AA sobre qualquer foto); as bordas deixam a equipe à mostra */
	.mosaico_veu {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(ellipse 42% 56% at 50% 50%, rgb(37 40 50 / 0.9) 0%, rgb(37 40 50 / 0.86) 60%, rgb(37 40 50 / 0.2) 100%),
			linear-gradient(to bottom, rgb(37 40 50 / 0.35), transparent 22%, transparent 70%, rgb(37 40 50 / 0.75));
	}

	.mosaico_legenda {
		position: absolute;
		left: clamp(1rem, 3vw, 2.5rem);
		bottom: 1.25rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		color: var(--white);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		pointer-events: none;
		transition: opacity 0.35s ease;
	}

	.mosaico_legenda::before {
		content: "";
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--primary600);
	}

	.mosaico_legenda.is-trocando {
		opacity: 0;
	}

	.mosaico:not(.is-vivo) .mosaico_legenda {
		display: none;
	}

	/* Celular: a equipe numa faixa logo abaixo do menu (o recorte tira só copa de árvore e pernas), que se
	   dissolve no fundo escuro do texto */
	@media (prefers-reduced-motion: reduce) {
		.mosaico_grade :global(.mosaico_ladrilho),
		.mosaico_grade :global(.mosaico_carta) {
			transition: none;
			animation: none;
		}
	}

	@media (max-width: 767px) {
		.mosaico {
			bottom: auto;
			height: calc(100vw / 1.95);
		}

		.mosaico_veu {
			background: linear-gradient(to bottom, transparent, rgb(37 40 50 / 0.1) 55%, rgb(37 40 50 / 0.8) 85%, var(--graywarm900));
		}

		.mosaico_legenda {
			display: none;
		}
	}
</style>
