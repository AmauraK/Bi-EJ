---
// Fundo da dobra 1 da home: quadros de fotos reais da equipe, cada um montado por ladrilhos, ao redor do texto
// (o centro fica escuro, só com a textura da seção). Nossas fotos têm o grupo no meio, então cada quadro mostra
// uma foto inteira enquadrada pelos rostos (FOTOS[x].rostos) e só recebe fotos em que ninguém fique cortado.
// No desktop são 4 quadros nas laterais; abaixo de 1200px, uma faixa acima do texto (1 quadro no celular).
// Movimento: cada quadro se monta (ladrilhos deslizam e viram em 3D) assim que a sua foto chega; a cada ~5 s um
// quadro vira em onda e troca de foto; o mouse sobre um quadro faz a onda partir do ladrilho tocado.
// Sem JS ou com movimento reduzido: as 4 fotos paradas, nos mesmos quadros.
import { Image, getImage } from 'astro:assets';
import { FOTOS, type Foto } from '../../consts';

// Ordem dos quadros: [esquerda alto, esquerda baixo, direita alto, direita baixo]. O 1º é o único do celular,
// por isso é o close das consultoras (rostos grandes em qualquer recorte).
const iniciais = [FOTOS.consultorasDocumento, FOTOS.equipeEscadaria, FOTOS.consultoresNotebook, FOTOS.equipeAuditorio];
// A equipe completa (100 pessoas) fica de fora: num quadro deste tamanho os rostos viram pontos
const trocas = [FOTOS.equipeConvite, FOTOS.equipeReuniao];

// Fila de fotos dos quadros (as fotos de troca carregam depois, quando o navegador fica ocioso)
const fotos = await Promise.all(
	[...iniciais, ...trocas].map(async (f: Foto) => ({
		src: (await getImage({ src: f.src, width: 640, quality: 60, format: 'webp' })).src,
		srcGrande: (await getImage({ src: f.src, width: 960, quality: 60, format: 'webp' })).src,
		w: f.src.width,
		h: f.src.height,
		rostos: f.rostos!,
	})),
);
// Foco aproximado da foto parada (o script recalcula o enquadramento exato para o tamanho de cada quadro)
const foco = (f: Foto) => `${((f.rostos![0] + f.rostos![2]) / 2) * 100}% ${((f.rostos![1] + f.rostos![3]) / 2) * 100}%`;
// Largura do quadro × 1,5 no desktop e no tablet (o enquadramento aproxima até 1,5× nos rostos); na faixa do
// celular o close das consultoras aproxima pouco
const sizes = '(min-width: 1200px) calc(75vw - 585px), (min-width: 768px) 72vw, 100vw';
---

<div class="mosaico" data-mosaico data-fotos={JSON.stringify(fotos)}>
	{iniciais.map((f, i) => (
		<figure class={`mosaico_quadro is-q${i + 1}`} data-quadro={i}>
			<Image
				src={f.src}
				alt={f.alt}
				widths={[320, 480, 640, 960]}
				quality={60}
				sizes={sizes}
				loading={i === 0 ? 'eager' : 'lazy'}
				style={`object-position: ${foco(f)}`}
			/>
		</figure>
	))}
</div>
<script is:inline>
	// Antes da 1ª pintura: com movimento liberado, as fotos paradas dão lugar aos ladrilhos. Se nenhum quadro
	// se montar em 2 s (script atrasado), as fotos paradas aparecem.
	(() => {
		const raiz = document.querySelector('[data-mosaico]');
		if (!raiz || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		raiz.dataset.movimento = '1';
		raiz.classList.add('is-vivo');
		setTimeout(() => raiz.querySelector('.is-montado') || raiz.classList.remove('is-vivo'), 2000);
	})();
</script>

<script>
	type Foto = { id: number; src: string; srcGrande: string; w: number; h: number; rostos: number[]; pronta: boolean };
	type Ladrilho = { carta: HTMLElement; faces: HTMLElement[]; c: number; r: number };
	type Quadro = { el: HTMLElement; img: HTMLImageElement; foto: Foto; lado: number; ladrilhos: Ladrilho[]; cols: number; rows: number; W: number; H: number; ocupado: boolean; sobre: boolean };

	const raiz = document.querySelector<HTMLElement>('[data-mosaico]');
	if (raiz?.dataset.movimento) {
		const PAUSA = 5000; // intervalo entre as trocas periódicas (uma por vez, alternando os quadros)
		const MARGEM = 0.02; // folga mínima entre os rostos e a borda do quadro, em fração da foto
		const RESPIRO = 0.06; // espaço em volta dos rostos quando o quadro aproxima
		const ZOOM = 1.5; // aproximação máxima além do "cover"
		const grandes = devicePixelRatio * innerWidth > 1600;
		const fotos = (JSON.parse(raiz.dataset.fotos!) as Omit<Foto, 'id' | 'pronta'>[]).map((f, id) => ({ ...f, src: grandes ? f.srcGrande : f.src, id, pronta: false }));
		const quadros: Quadro[] = Array.from(raiz.querySelectorAll<HTMLElement>('[data-quadro]'), (el) => ({
			el,
			img: el.querySelector('img')!,
			foto: { ...fotos[Number(el.dataset.quadro)] },
			lado: 0,
			ladrilhos: [],
			cols: 0, rows: 0, W: 0, H: 0,
			ocupado: false,
			sobre: false,
		}));
		const passar = matchMedia('(hover: hover)').matches;
		let vez = 0, proximo = 0, visivel = true;

		// Recorte centrado nos rostos e preso às bordas da foto: aproxima (até ZOOM além do "cover") até os rostos,
		// com RESPIRO, ocuparem o quadro; `cabe` diz se todos os rostos ficam inteiros
		const enquadrar = (f: Foto, W: number, H: number) => {
			const [x0, y0, x1, y1] = f.rostos;
			const cover = Math.max(W / f.w, H / f.h);
			const justo = Math.min(W / ((x1 - x0 + 2 * RESPIRO) * f.w), H / ((y1 - y0 + 2 * RESPIRO) * f.h));
			const s = Math.min(Math.max(justo, cover), cover * ZOOM);
			const jw = W / (f.w * s), jh = H / (f.h * s);
			const jx = Math.min(Math.max((x0 + x1) / 2 - jw / 2, 0), 1 - jw);
			const sobra = jh - (y1 - y0) - 2 * RESPIRO; // altura além dos rostos: 35% vai acima, 65% abaixo deles
			const jy = Math.min(Math.max(y0 - RESPIRO - (sobra > 0 ? sobra * 0.35 : sobra / 2), 0), 1 - jh);
			const folga = (a: number, j: number) => Math.min(MARGEM, a, j); // perto da borda da foto, basta caber
			const cabe = x0 - jx >= folga(x0, jx) && jx + jw - x1 >= folga(1 - x1, 1 - jx - jw) && y0 - jy >= folga(y0, jy) && jy + jh - y1 >= folga(1 - y1, 1 - jy - jh);
			return { bw: f.w * s, bh: f.h * s, ox: -jx * f.w * s, oy: -jy * f.h * s, cabe };
		};
		// A face fica 1px para dentro do ladrilho (a fresta de 2px entre eles)
		const pintar = (face: HTMLElement, q: Quadro, f: Foto, t: Ladrilho) => {
			const { bw, bh, ox, oy } = enquadrar(f, q.W, q.H);
			face.style.backgroundImage = `url("${f.src}")`;
			face.style.backgroundSize = `${bw}px ${bh}px`;
			face.style.backgroundPosition = `${ox - t.c * (q.W / q.cols) - 1}px ${oy - t.r * (q.H / q.rows) - 1}px`;
		};
		const virar = (t: Ladrilho, virada: boolean, atraso: number) => {
			t.carta.style.setProperty('--d', `${atraso}ms`);
			t.carta.classList.toggle('is-virada', virada);
		};

		const montar = (q: Quadro) => {
			q.W = q.el.clientWidth;
			q.H = q.el.clientHeight;
			q.ladrilhos = [];
			q.el.querySelector('.mosaico_ladrilhos')?.remove();
			if (!q.W) return; // quadro escondido neste tamanho de tela
			q.cols = Math.max(2, Math.round(q.W / 110));
			q.rows = Math.max(q.H < 160 ? 1 : 2, Math.round(q.H / (q.W / q.cols))); // faixa baixa do celular: 1 linha, sem fresta nos rostos
			q.lado = 0;
			const tw = q.W / q.cols, th = q.H / q.rows;
			const grade = document.createElement('div');
			grade.className = 'mosaico_ladrilhos';
			grade.setAttribute('aria-hidden', 'true');
			for (let r = 0; r < q.rows; r++) {
				for (let c = 0; c < q.cols; c++) {
					const el = document.createElement('div');
					el.className = 'mosaico_ladrilho';
					el.style.cssText = `left:${c * tw}px;top:${r * th}px;width:${tw}px;height:${th}px`;
					el.innerHTML = '<div class="mosaico_carta"><i></i><i></i></div>';
					const carta = el.firstElementChild as HTMLElement;
					const t = { carta, faces: Array.from(carta.children) as HTMLElement[], c, r };
					pintar(t.faces[0], q, q.foto, t);
					q.ladrilhos.push(t);
					grade.append(el);
				}
			}
			q.el.append(grade);
			q.el.classList.add('is-montado');
			raiz.classList.add('is-vivo'); // se a foto parada já apareceu (script atrasado), os ladrilhos a substituem
		};

		// Abertura do quadro: ladrilhos virados (lado escuro), menores e embaralhados na linha; em onda diagonal,
		// cada um desliza para o lugar e vira mostrando o seu pedaço da foto.
		const abrir = (q: Quadro, i: number) => {
			const tiles = Array.from(q.el.querySelectorAll<HTMLElement>('.mosaico_ladrilho'));
			for (let r = 0; r < q.rows; r++) {
				const ordem = [...Array(q.cols).keys()].sort(() => Math.random() - 0.5);
				for (let c = 0; c < q.cols; c++) {
					const el = tiles[r * q.cols + c];
					el.style.setProperty('--dx', `${(ordem[c] - c) * (q.W / q.cols)}px`);
					el.classList.add('is-solto');
					q.ladrilhos[r * q.cols + c].carta.classList.add('is-virada');
				}
			}
			requestAnimationFrame(() => requestAnimationFrame(() => {
				for (const [n, t] of q.ladrilhos.entries()) {
					const atraso = i * 120 + ((t.c / q.cols + t.r / q.rows) / 2) * 450 + Math.random() * 80;
					tiles[n].style.setProperty('--d', `${atraso}ms`);
					tiles[n].classList.remove('is-solto');
					virar(t, false, atraso);
				}
			}));
		};

		// Troca: a próxima foto que ainda não está na tela e cabe neste quadro, em onda a partir de `origem`
		const trocar = (q: Quadro, origem = [0, 0]) => {
			if (q.ocupado || !q.ladrilhos.length) return;
			const naTela = new Set(quadros.filter((v) => v.ladrilhos.length).map((v) => v.foto.id));
			const opcoes = fotos.filter((f) => f.pronta && !naTela.has(f.id) && enquadrar(f, q.W, q.H).cabe);
			if (!opcoes.length) return;
			const f = opcoes[vez++ % opcoes.length];
			const oculto = 1 - q.lado;
			let fim = 0;
			q.ocupado = true;
			q.foto = f;
			q.lado = oculto;
			for (const t of q.ladrilhos) {
				const atraso = Math.hypot(t.c - origem[0], t.r - origem[1]) * 90;
				fim = Math.max(fim, atraso);
				pintar(t.faces[oculto], q, f, t);
				virar(t, oculto === 1, atraso);
			}
			setTimeout(() => (q.ocupado = false), fim + 1000);
		};

		const preparar = (q: Quadro, i: number, abertura: boolean) => {
			if (!q.el.clientWidth) return;
			q.img.decode().catch(() => undefined).then(() => {
				if (q.foto.id === Number(q.el.dataset.quadro)) q.foto.src = q.img.currentSrc || q.img.src;
				const animar = abertura && raiz.classList.contains('is-vivo');
				montar(q);
				if (animar) abrir(q, i);
			});
		};
		quadros.forEach((q, i) => preparar(q, i, true));

		if (passar) {
			for (const q of quadros) {
				q.el.addEventListener('pointerenter', (e) => {
					q.sobre = true;
					const caixa = q.el.getBoundingClientRect();
					trocar(q, [Math.floor(((e.clientX - caixa.left) / caixa.width) * q.cols), Math.floor(((e.clientY - caixa.top) / caixa.height) * q.rows)]);
				});
				q.el.addEventListener('pointerleave', () => (q.sobre = false));
			}
		}

		// Fotos de troca: carregam quando o navegador fica ocioso; as que falharem nunca entram
		const ocioso = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 4000 }) : setTimeout(fn, 2500));
		ocioso(() => {
			for (const f of fotos) {
				const img = new Image();
				img.onload = () => (f.pronta = true);
				img.src = f.src;
			}
		});

		setInterval(() => {
			const livres = quadros.filter((q) => q.ladrilhos.length && !q.sobre);
			if (!visivel || document.hidden || !livres.length) return;
			trocar(livres[proximo++ % livres.length]);
		}, PAUSA);

		new IntersectionObserver(([e]) => (visivel = e.isIntersecting)).observe(raiz);

		// Mudou o tamanho (girar o celular, redimensionar): remonta os quadros visíveis, já prontos, sem abertura
		let redim = 0, largura = innerWidth;
		addEventListener('resize', () => {
			if (innerWidth === largura) return; // barra de endereço do celular aparecendo/sumindo
			largura = innerWidth;
			clearTimeout(redim);
			redim = window.setTimeout(() => quadros.forEach((q, i) => (q.ladrilhos.length || q.el.clientWidth) && preparar(q, i, false)), 200);
		});
	}
</script>

<style>
	/* Desktop: 2 quadros de cada lado, desencontrados, fora dos 720px centrais do texto */
	.mosaico {
		--borda: clamp(1rem, 2vw, 2rem);
		--qw: calc(50% - 360px - var(--borda));
		position: absolute;
		inset: var(--nav-height) 0 0;
		z-index: 1;
	}

	.mosaico_quadro {
		position: absolute;
		width: var(--qw);
		aspect-ratio: 1.15;
		max-height: 42%;
		margin: 0;
		border-radius: 6px;
		background: rgb(249 255 252 / 0.04);
	}

	.is-q1 { left: var(--borda); top: 3%; }
	.is-q2 { left: var(--borda); top: 50%; }
	.is-q3 { right: var(--borda); top: 9%; }
	.is-q4 { right: var(--borda); top: 56%; }

	.mosaico_quadro img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 6px;
	}

	.mosaico.is-vivo .mosaico_quadro img {
		visibility: hidden;
	}

	.mosaico_quadro :global(.mosaico_ladrilhos) {
		position: absolute;
		inset: 0;
	}

	.mosaico_quadro :global(.mosaico_ladrilho) {
		position: absolute;
		transition: transform 0.8s cubic-bezier(0.22, 0.75, 0.2, 1) var(--d, 0ms);
	}

	.mosaico_quadro :global(.mosaico_ladrilho.is-solto) {
		transform: translateX(var(--dx, 0)) scale(0.82);
	}

	.mosaico_quadro :global(.mosaico_carta) {
		position: absolute;
		inset: 0;
		transform: perspective(700px) rotateY(0deg);
		transform-style: preserve-3d;
		transition: transform 0.75s cubic-bezier(0.3, 0.6, 0.2, 1) var(--d, 0ms);
	}

	.mosaico_quadro :global(.mosaico_carta.is-virada) {
		transform: perspective(700px) rotateY(180deg);
	}

	.mosaico_quadro :global(.mosaico_carta i) {
		position: absolute;
		inset: 1px;
		border-radius: 3px;
		background-color: color-mix(in srgb, var(--graywarm900) 90%, var(--white));
		background-repeat: no-repeat;
		backface-visibility: hidden;
	}

	.mosaico_quadro :global(.mosaico_carta i + i) {
		transform: rotateY(180deg);
	}

	/* Tablet e celular: faixa de quadros logo abaixo do menu, acima do texto (1 quadro no celular) */
	@media (max-width: 1199px) {
		.mosaico {
			inset: calc(var(--nav-height) + 12px) 16px auto;
			display: flex;
			gap: 12px;
			height: var(--faixa);
		}

		.mosaico_quadro {
			position: relative;
			inset: auto;
			flex: 1;
			width: auto;
			height: 100%;
			aspect-ratio: auto;
			max-height: none;
		}

		.is-q2,
		.is-q4 {
			display: none;
		}
	}

	@media (max-width: 767px) {
		.is-q3 {
			display: none;
		}
	}
</style>
