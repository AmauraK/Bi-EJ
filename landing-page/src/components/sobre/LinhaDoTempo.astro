---
import { NUMEROS } from '../../consts';

const marcos = [
  {
    periodo: '1967',
    titulo: 'O surgimento do Movimento Empresa Júnior na França',
    texto:
      'Alunos da ESSEC (École Supérieure des Sciences Économiques et Commerciales), em Paris, fundam a primeira Empresa Júnior do mundo, a Junior ESSEC Conseil, para aplicar na prática o conhecimento acadêmico em projetos empresariais.',
    confirmado: true,
  },
  {
    periodo: String(NUMEROS.fundacao),
    titulo: 'Fundação da EJFGV em São Paulo — a 1ª da América Latina',
    texto:
      'Estudantes da Fundação Getulio Vargas em São Paulo fundam a EJFGV, trazendo o Movimento Empresa Júnior para o Brasil e inaugurando a primeira Empresa Júnior da América Latina.',
    confirmado: true,
  },
  {
    periodo: 'Anos 1990',
    titulo: 'Consolidação e expansão do movimento no país',
    texto: 'Consolidação das primeiras diretorias e difusão do modelo de consultoria júnior pelo Brasil.',
    pendente: 'Marco histórico a preencher pelo Marketing (Anos 1990)',
  },
  {
    periodo: 'Anos 2000',
    titulo: 'Estruturação metodológica e grandes clientes',
    texto: 'Evolução das frentes de projetos estratégicos e parcerias institucionais com empresas de referência.',
    pendente: 'Marco histórico a preencher pelo Marketing (Anos 2000)',
  },
  {
    periodo: 'Anos 2010',
    titulo: 'Excelência em gestão e alto impacto na rede Brasil Júnior',
    texto: 'Fortalecimento da cultura orientada a resultados e ampliação das especialidades de consultoria.',
    pendente: 'Marco histórico a preencher pelo Marketing (Anos 2010)',
  },
  {
    periodo: '2020–2025',
    titulo: 'Transformação digital e frente de Business Intelligence',
    texto: 'Expansão dos projetos de dados, dashboards executivos e automação com Inteligência Artificial.',
    pendente: 'Marco histórico a preencher pelo Marketing (2020–2025)',
  },
  {
    periodo: 'Hoje',
    titulo: `${NUMEROS.projetosFormatado} projetos entregues e ${NUMEROS.anosMercado} anos de atuação`,
    texto: `Com ${NUMEROS.anosMercado} anos de história desde ${NUMEROS.fundacao}, a EJFGV acumula ${NUMEROS.projetosFormatado} projetos entregues em ${NUMEROS.setores} setores da economia e mantém NPS ${NUMEROS.nps} (${NUMEROS.npsAno}), consolidando-se como referência em consultoria estratégica estudantil no Brasil.`,
    confirmado: true,
  },
];
---

<section class="section_beneficios padding-section-medium" aria-labelledby="linha-tempo-titulo">
  <div class="page-padding">
    <div class="container-large">
      <div class="beneficios_title">
        <span class="beneficios_eyebrow">Nossa Trajetória · 1967 → {NUMEROS.fundacao} → Hoje</span>
        <h2 id="linha-tempo-titulo">Da sala de aula para o mercado: a história da primeira Empresa Júnior da América Latina</h2>
        <p>
          Mais de três décadas conectando o rigor acadêmico da Fundação Getulio Vargas aos desafios reais de empresas em todo o país.
        </p>
      </div>

      <ol class="timeline_grid">
        {marcos.map((marco) => (
          <li class:list={['timeline_card', { 'is-highlight': marco.confirmado }]}>
            <span class="timeline_periodo">{marco.periodo}</span>
            <h3>{marco.titulo}</h3>
            <p>{marco.texto}</p>
            {marco.pendente && (
              <div class="timeline_badge">
                <span class="preencher">{marco.pendente}</span>
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline_grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .timeline_card {
    background: var(--graywarm950);
    border: 1px solid var(--border-hairline-dark);
    border-radius: var(--card-radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .timeline_card.is-highlight {
    border-color: var(--primary500);
  }

  .timeline_periodo {
    display: inline-flex;
    align-self: flex-start;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary200);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .timeline_card h3 {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--white);
    line-height: 1.3;
  }

  .timeline_card p {
    font-size: 0.9rem;
    color: var(--graywarm300);
    line-height: 1.6;
  }

  .timeline_badge {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  @media (max-width: 1024px) {
    .timeline_grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .timeline_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
