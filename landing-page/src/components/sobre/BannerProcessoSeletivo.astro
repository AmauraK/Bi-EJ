---
import { SITE } from '../../consts';

const beneficiosAluno = [
  'Aprendizado prático em projetos reais de consultoria para empresas de diversos setores',
  'Mentoria próxima com ex-membros (alumni), professores da FGV e consultorias parceiras como a Bain & Company',
  'Desenvolvimento acelerado de liderança, visão de negócios, comunicação executiva e trabalho em equipe',
  'Acesso a uma rede de contatos qualificada no mercado financeiro, consultorias estratégicas e tecnologia',
];
---

<section class="padding-section-medium" aria-labelledby="seja-consultor-titulo">
  <div class="page-padding">
    <div class="container-large">
      <div class="seja-consultor_banner">
        <div class="seja-consultor_copy">
          <span class="eyebrow is-dark">Processo Seletivo · Graduação FGV</span>
          <h2 id="seja-consultor-titulo">Seja consultor da EJFGV</h2>
          <p>
            Se você é estudante de graduação da Fundação Getulio Vargas em São Paulo e quer transformar sua formação acadêmica em experiência real de mercado desde os primeiros semestres, venha construir a EJFGV conosco.
          </p>

          <ul class="vantagens_list">
            {beneficiosAluno.map((item) => (
              <li class="vantagens_list-item">
                <img src={SITE.iconeCheck} alt="Benefício confirmado" loading="lazy" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="seja-consultor_cta-box">
          <h3>Inscrições e informações</h3>
          <p>
            Nosso Processo Seletivo ocorre semestralmente para alunos dos cursos de graduação da FGV em São Paulo.
          </p>
          <span class="preencher">Link do Processo Seletivo vigente: a preencher pelo Marketing</span>
          <a href="/contato/" class="button is-button-large">
            Tirar dúvidas com nossa equipe
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .seja-consultor_banner {
    background: var(--graywarm900);
    color: var(--white);
    border: 1px solid var(--border-hairline-dark);
    border-radius: var(--card-radius-xl);
    padding: clamp(2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .seja-consultor_copy h2 {
    font-size: clamp(1.75rem, 2.6vw, 2.35rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--white);
    margin-bottom: 0.85rem;
  }

  .seja-consultor_copy p {
    font-size: 1rem;
    color: var(--graywarm300);
    line-height: 1.65;
  }

  .seja-consultor_cta-box {
    background: var(--graywarm950);
    border: 1px solid var(--border-hairline-dark);
    border-radius: var(--card-radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .seja-consultor_cta-box h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--white);
  }

  .seja-consultor_cta-box p {
    font-size: 0.9rem;
    color: var(--graywarm300);
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .seja-consultor_banner {
      grid-template-columns: 1fr;
    }
  }
</style>
