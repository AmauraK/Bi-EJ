---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ImagemReservada from '../components/ImagemReservada.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import NewsletterBox from '../components/conteudo/NewsletterBox.astro';
import { NUMEROS, POSTS_BLOG, SOLUCOES } from '../consts';

const CATEGORIAS_BLOG = [
  'Todos',
  'Plano de Negócios',
  'Mercadológica',
  'Financeira',
  'Operacional',
  'Business Intelligence',
] as const;

const faqBlog = [
  {
    pergunta: 'Quem elabora e revisa os artigos publicados no Blog da EJFGV?',
    resposta: `Os artigos são pesquisados e redigidos pelos consultores da EJFGV — estudantes de graduação da Fundação Getulio Vargas em São Paulo — a partir da vivência prática em ${NUMEROS.projetosFormatado} projetos entregues desde ${NUMEROS.fundacao} e da literatura acadêmica recomendada pelos professores da FGV.`,
    validar: true,
  },
  {
    pergunta: 'Como posso aplicar um tema que li no blog na realidade da minha empresa?',
    resposta:
      'Cada artigo indica a frente de consultoria relacionada ao tema (Plano de Negócios, Mercadológica, Financeira, Operacional ou Business Intelligence). Você pode solicitar um diagnóstico gratuito pelo site para que nossa equipe avalie o cenário específico do seu negócio e desenhe um projeto sob medida.',
    validar: true,
  },
  {
    pergunta: 'Os conteúdos são voltados apenas para empresas de um porte ou setor específico?',
    resposta: `Escrevemos com linguagem direta para empreendedores, sócios e gestores de pequenas e médias empresas (B2B e B2C). Como já atuamos em mais de ${NUMEROS.setores} setores da economia, nossos guias abordam fundamentos de gestão que podem ser adaptados a comércios, serviços, indústrias e negócios digitais.`,
    validar: true,
  },
  {
    pergunta: 'Além dos artigos do blog, a EJFGV oferece materiais mais aprofundados para download?',
    resposta:
      'Sim. Na nossa página de Materiais Ricos disponibilizamos gratuitamente e-books passo a passo sobre Google Ads, Power BI e Projeções e Modelagem Financeira, além da Carta de Serviços institucional da EJFGV.',
    validar: true,
  },
];
---

<Layout
  titulo="Blog da EJFGV — Conteúdos Práticos de Gestão, Finanças, Marketing e Business Intelligence"
  descricao="Leia artigos práticos elaborados pelos consultores da EJFGV (Fundação Getulio Vargas, desde 1988) para apoiar PMEs em estratégia, finanças, marketing, operações e Business Intelligence."
  canonicalPath="/blog/"
  ctaHref="/contato/#formulario"
>
  <PageHeader
    escura={true}
    breadcrumb={[
      { rotulo: 'Início', href: '/' },
      { rotulo: 'Blog' },
    ]}
    eyebrow={`Conhecimento Aplicado · Desde ${NUMEROS.fundacao}`}
    titulo="Blog da EJFGV: conteúdos práticos para decisões de negócios"
    lead="Artigos objetivos sobre estratégia, finanças, marketing, operações e Business Intelligence elaborados para empresários e gestores de pequenas e médias empresas."
    abertura={`O Blog da EJFGV é o canal editorial da Empresa Júnior da Fundação Getulio Vargas (atuante desde ${NUMEROS.fundacao}, com ${NUMEROS.projetosFormatado} projetos entregues em ${NUMEROS.setores} setores). Traduzimos metodologias de gestão empresarial e aprendizado real de consultoria em guias claros para apoiar líderes de PMEs a resolver gargalos operacionais, organizar o caixa, atrair clientes e decidir com base em dados.`}
    imagemRotulo="Consultores da EJFGV elaborando artigos e estudos de gestão na Fundação Getulio Vargas em São Paulo"
    imagemProporcao="16/10"
    acoes={[
      {
        rotulo: 'Explorar artigos',
        href: '#artigos',
        variante: 'primary',
        grande: true,
      },
      {
        rotulo: 'Solicitar diagnóstico gratuito',
        href: '/contato/#formulario',
        variante: 'secondary',
        grande: true,
      },
    ]}
  />

  <section id="artigos" class="section_blog padding-section-medium">
    <div class="page-padding">
      <div class="container-large">
        <div class="blog_header">
          <div>
            <span class="eyebrow">Acervo de Artigos Recentes</span>
            <h2>Explore nossos conteúdos por área de gestão</h2>
            <p class="blog_subtitle">
              Filtre por especialidade para encontrar artigos alinhados ao desafio atual da sua empresa ou navegue pelos {POSTS_BLOG.length} conteúdos mais recentes.
            </p>
          </div>

          <p class="blog_wp-note">
            <span class="preencher">
              Arquitetura em definição: convivência técnica do /blog/ com a estrutura de artigos no WordPress durante a troca de domínio
            </span>
          </p>
        </div>

        <div
          class="blog_filters"
          role="toolbar"
          aria-label="Filtrar artigos por categoria de consultoria"
        >
          {CATEGORIAS_BLOG.map((cat, idx) => (
            <button
              type="button"
              class:list={['tag-chip', { 'is-active': idx === 0 }]}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              data-blog-filter={cat}
            >
              <span>{cat}</span>
            </button>
          ))}
        </div>

        <p class="blog_count" id="blogCount" aria-live="polite">
          Exibindo todos os {POSTS_BLOG.length} artigos recentes
        </p>

        <div class="blog_grid" id="blogGrid">
          {POSTS_BLOG.map((post) => (
            <article class="case_card blog_card" data-blog-card data-categoria={post.categoria}>
              <div class="blog_card-top">
                <ImagemReservada
                  rotulo={`Capa do artigo: ${post.titulo}`}
                  proporcao="16/9"
                  classe="blog_card-cover"
                />
                <div class="blog_card-meta">
                  <span class="case_tag">{post.categoria}</span>
                </div>
                <h3>{post.titulo}</h3>
                <p>{post.resumo}</p>
              </div>

              <div class="blog_card-actions">
                <a
                  href={post.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="blog_read-link"
                >
                  <span>Ler artigo completo</span>
                  <span aria-hidden="true">↗</span>
                </a>

                <a href={post.solucaoHref} class="blog_solucao-link">
                  <span>Conhecer consultoria relacionada →</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section_blog-ponte padding-section-medium" aria-labelledby="ponte-comercial-heading">
    <div class="page-padding">
      <div class="container-large">
        <div class="blog_ponte-header">
          <div>
            <span class="eyebrow">Da Leitura à Prática</span>
            <h2 id="ponte-comercial-heading">
              Quer aprofundar o estudo ou aplicar esses conceitos com apoio da EJFGV?
            </h2>
          </div>
          <a href="/materiais-ricos/" class="button-secondary">
            Acessar E-books e Carta de Serviços
          </a>
        </div>

        <div class="blog_solucoes-strip">
          {SOLUCOES.map((sol) => (
            <a href={sol.url} class="blog_solucao-pill">
              <span class="blog_solucao-pill-cat">{sol.categoria}</span>
              <strong>{sol.nome}</strong>
              <span class="blog_solucao-pill-desc">{sol.desafio}</span>
              <span class="blog_solucao-pill-cta">Ver escopo da solução →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <NewsletterBox idPrefix="blog-nl" />

  <Faq
    eyebrow="Dúvidas sobre o Blog e Diagnóstico"
    titulo="Perguntas frequentes sobre nossos conteúdos e consultoria"
    itens={faqBlog}
  />

  <CtaBanner
    titulo="Quer transformar os desafios que você leu aqui em um plano prático para sua empresa?"
    subtitulo="Agende uma conversa de diagnóstico gratuito com nossos consultores e receba uma análise sob medida das prioridades do seu negócio."
    rotuloBotao="Solicitar diagnóstico gratuito"
    href="/contato/#formulario"
  />
</Layout>

<script>
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]')
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-blog-card]')
  );
  const countEl = document.getElementById('blogCount');

  if (filterButtons.length > 0 && cards.length > 0) {
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-blog-filter') || 'Todos';

        filterButtons.forEach((b) => {
          const isCurrent = b === btn;
          b.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
          b.classList.toggle('is-active', isCurrent);
        });

        let visibleCount = 0;
        cards.forEach((card) => {
          const cat = card.getAttribute('data-categoria') || '';
          const match = selected === 'Todos' || cat === selected;
          if (match) {
            card.removeAttribute('hidden');
            visibleCount++;
          } else {
            card.setAttribute('hidden', '');
          }
        });

        if (countEl) {
          countEl.textContent =
            selected === 'Todos'
              ? `Exibindo todos os ${visibleCount} artigos recentes`
              : `Exibindo ${visibleCount} ${visibleCount === 1 ? 'artigo' : 'artigos'} na categoria "${selected}"`;
        }
      });
    });
  }
</script>

<style>
  .section_blog {
    background: var(--white);
  }

  .blog_header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .blog_header h2 {
    font-size: clamp(1.65rem, 2.5vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.18;
    color: var(--gray900);
    margin-top: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .blog_subtitle {
    font-size: 1rem;
    color: var(--gray600);
    max-width: 62ch;
    line-height: 1.6;
  }

  .blog_wp-note {
    max-width: 44ch;
  }

  .blog_filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .blog_count {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gray600);
    margin-bottom: 1.75rem;
  }

  .blog_grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .blog_card {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .blog_card[hidden] {
    display: none;
  }

  .blog_card-top {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .blog_card :global(.blog_card-cover) {
    min-height: 180px;
    padding: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .blog_card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .blog_card-meta .case_tag {
    margin-bottom: 0;
  }

  .blog_card h3 {
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.32;
    color: var(--gray900);
  }

  .blog_card p {
    font-size: 0.925rem;
    color: var(--gray600);
    line-height: 1.58;
  }

  .blog_card-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 1rem;
    border-top: 1px solid var(--gray200);
  }

  .blog_read-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--gray900);
    padding: 0.55rem 0.85rem;
    border-radius: var(--btn-radius);
    background: var(--gray50);
    border: 1px solid var(--gray200);
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .blog_read-link:hover {
    border-color: var(--primary500);
    background: var(--primary50);
    color: var(--primary700);
  }

  .blog_solucao-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary700);
    padding: 0.25rem 0.2rem;
    transition: color 0.2s;
  }

  .blog_solucao-link:hover {
    color: var(--primary800);
    text-decoration: underline;
  }

  .section_blog-ponte {
    background: var(--gray50);
    border-top: 1px solid var(--gray200);
  }

  .blog_ponte-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .blog_ponte-header h2 {
    font-size: clamp(1.5rem, 2.3vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--gray900);
    max-width: 38ch;
    margin-top: 0.35rem;
  }

  .blog_solucoes-strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .blog_solucao-pill {
    background: var(--white);
    border: 1px solid var(--gray200);
    border-radius: var(--card-radius-md);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    transition: border-color 0.2s, transform 0.2s var(--ease-out-expo);
  }

  .blog_solucao-pill:hover {
    border-color: var(--primary500);
    transform: translateY(-2px);
  }

  .blog_solucao-pill-cat {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary700);
  }

  .blog_solucao-pill strong {
    font-size: 1rem;
    font-weight: 800;
    color: var(--gray900);
  }

  .blog_solucao-pill-desc {
    font-size: 0.85rem;
    color: var(--gray600);
    line-height: 1.45;
  }

  .blog_solucao-pill-cta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary700);
    margin-top: 0.35rem;
  }

  @media (max-width: 1024px) {
    .blog_grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .blog_solucoes-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .blog_grid,
    .blog_solucoes-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
