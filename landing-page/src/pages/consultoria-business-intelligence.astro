---
// Consultoria de Business Intelligence. A moldura (cabeçalho, números, prova social, método, FAQ, formulário)
// vem do SolucaoLayout; aqui ficam só "Para quem é" e "O que entra no projeto".
// Escopo e dores vêm de consts.ts (escopo, quandoFazSentido); formatos de entrega, da LP original.
import SolucaoLayout from '../layouts/SolucaoLayout.astro';
import { CDN, NUMEROS, SOLUCOES, DEPOIMENTOS } from '../consts';

const solucao = SOLUCOES.find((s) => s.slug === 'consultoria-business-intelligence')!;
const sol = (slug: string) => SOLUCOES.find((s) => s.slug === slug)!;

const CHECK = `${CDN}/671c665a9c8c2a788c93dd9b_check-icon.svg`;

const abertura = 'Organizamos os dados que a sua empresa já tem e os transformamos em painéis e análises que mostram o que vender, onde cortar custos e quem é o seu cliente. Para pequenas e médias empresas que querem parar de decidir no feeling.';

// Rascunhos feitos só com fatos de consts.ts e da LP (validar: true). Preço não tem fonte: fica a preencher.
const faq = [
	{
		pergunta: 'O que faz a consultoria de Business Intelligence da EJFGV?',
		resposta: 'Transforma os dados da sua empresa em decisões. Conforme a necessidade, o projeto inclui painéis para acompanhar vendas, custos e indicadores, projeções de vendas e demanda, a divisão dos clientes em grupos e a análise do perfil e da opinião dos consumidores. É feito por alunos da FGV, com orientação de professores da FGV.',
		validar: true,
	},
	{
		pergunta: 'Preciso ter os dados organizados antes de contratar?',
		resposta: 'Não. A consultoria também atende empresas que dependem de planilhas soltas ou de sistemas desconectados. Nesses casos, o projeto pode começar pela centralização dos dados, conectando vendas, financeiro e operação em uma base única e confiável.',
		validar: true,
	},
	{
		pergunta: 'Vocês trabalham com Power BI?',
		resposta: 'Sim. Construímos dashboards em Power BI, personalizados para a rotina da sua empresa, além de organizar bancos de dados e automatizar processos.',
		validar: true,
	},
	{
		pergunta: 'Quanto tempo dura um projeto?',
		resposta: `Os projetos da EJFGV têm em média ${NUMEROS.prazoMedioMeses} meses. O prazo de cada projeto é apresentado na proposta, junto com o escopo.`,
		validar: true,
	},
	{
		pergunta: 'Como o projeto começa? O diagnóstico é gratuito?',
		resposta: 'Sim, o diagnóstico é gratuito. Depois do primeiro contato com o nosso time comercial, fazemos uma reunião de diagnóstico para identificar dores, desafios e oportunidades. Em seguida, apresentamos uma proposta com escopo, prazos e soluções personalizadas para a sua empresa.',
		validar: true,
	},
	{ pergunta: 'Quanto custa um projeto de Business Intelligence?' },
];

// Dores do dono de PME, a partir de quandoFazSentido e do "Para quem é" da LP.
const dores = [
	{ icone: `${CDN}/672a37ae2d2e20a904bf4c11_pme-icon.svg`, titulo: 'Dados espalhados', texto: 'Vendas numa planilha, financeiro em outra, estoque no sistema. Fechar o mês consome horas da equipe.' },
	{ icone: `${CDN}/672a37aed9b0d27f7453d2a3_novas-icon.svg`, titulo: 'Decisões no feeling', texto: 'Preço, compras e metas saem da intuição, sem olhar o histórico do próprio negócio.' },
	{ icone: `${CDN}/671c65bc0ece9976827460a6_speed-icon.svg`, titulo: 'Custos que não fecham', texto: 'Você sabe que dá para ganhar eficiência, mas não sabe quais fatores mais pesam no resultado.' },
	{ icone: `${CDN}/672a37ae7609689739689139_transformacao-digital-icon.svg`, titulo: 'Cliente desconhecido', texto: 'Não está claro quem compra mais, quem parou de comprar e o que falam da sua marca.' },
];

// Cada frente do escopo (consts) traduzida na pergunta de negócio que ela responde.
const detalhes: Record<string, { pergunta: string; texto: string; entrega: string; veja?: { texto: string; slug: string } }> = {
	'Análises descritivas': {
		pergunta: 'O que está acontecendo na minha empresa?',
		texto: 'Organizamos o histórico de vendas, custos e operação para mostrar o que vende mais, onde a margem aperta e como cada número evolui mês a mês.',
		entrega: 'os indicadores certos para o seu negócio, em painéis fáceis de acompanhar.',
		veja: { texto: 'Se o problema for margem, veja também a', slug: 'consultoria-financeira' },
	},
	'Análises preditivas': {
		pergunta: 'O que deve acontecer nos próximos meses?',
		texto: 'Com o histórico da empresa e, quando faz sentido, dados de fora dela, como os do seu mercado, estimamos tendências de vendas e demanda para você planejar compras, estoque e equipe com antecedência.',
		entrega: 'projeções e cenários explicados em linguagem simples, prontos para o planejamento.',
	},
	'Clusterização': {
		pergunta: 'Que tipos de cliente eu tenho?',
		texto: 'Clusterização é separar clientes (ou produtos) em grupos parecidos entre si: os fiéis, os que só compram em promoção, os que sumiram. Cada grupo pede uma ação diferente, e você para de tratar todo mundo igual.',
		entrega: 'os grupos mapeados, com o perfil de cada um e o que fazer com ele.',
	},
	'Análise do perfil do consumidor': {
		pergunta: 'Quem é o meu cliente e o que ele pensa da minha marca?',
		texto: 'Traçamos o perfil de quem compra de você a partir dos dados de compra. Com análise de sentimentos, lemos comentários e avaliações em volume para separar o que agrada do que incomoda.',
		entrega: 'o retrato do seu cliente e os pontos que mais pesam na satisfação dele.',
		veja: { texto: 'Para transformar esse perfil em campanha, conheça a', slug: 'consultoria-mercadologica' },
	},
};

// Formatos de entrega (LP original: Power BI, base única, plano de ação, treinamento).
const formatos = [
	{ titulo: 'Seus dados em um só lugar', texto: 'Vendas, financeiro e operação reunidos em uma base confiável, sem consolidar planilhas toda semana.' },
	{ titulo: 'Painéis em Power BI', texto: 'Personalizados para a sua rotina, para acompanhar vendas, custos e metas sem montar relatório.' },
	{ titulo: 'Plano de ação', texto: 'Os números traduzidos em prioridades: onde está o gargalo e onde agir primeiro.' },
	{ titulo: 'Equipe treinada', texto: 'Treinamento prático para o seu time manter os painéis funcionando depois do projeto.' },
];
---

<SolucaoLayout
	solucao={solucao}
	abertura={abertura}
	faq={faq}
	kicker="Dados que viram decisão"
	fotoHeader="trabalho real em grupo: consultores da EJFGV analisando dados com o cliente"
	depoimentos={DEPOIMENTOS.slice(0, 2)}
>
	<section id="para-quem" class="section_icp" aria-labelledby="bi-para-quem-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="icp_header">
					<span class="eyebrow">Para quem é</span>
					<h2 id="bi-para-quem-titulo">Os números existem. Só não ajudam você a decidir.</h2>
				</div>
				<ul class="bi_dores">
					{dores.map((d) => (
						<li class="icp_item">
							<img src={d.icone} loading="lazy" alt="" class="icp_icon" />
							<h3>{d.titulo}</h3>
							<p>{d.texto}</p>
						</li>
					))}
				</ul>
				<div class="bi_aviso">
					<p><strong>Não precisa chegar com tudo organizado.</strong> O projeto pode começar pelas planilhas e sistemas que você já usa.</p>
					<a href="#formulario" class="button-tertiary">Contar como estão meus dados →</a>
				</div>
			</div>
		</div>
	</section>

	<section id="o-que-entra" class="section_beneficios" aria-labelledby="bi-escopo-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="beneficios_wrapper">
					<div class="beneficios_title">
						<span class="eyebrow">O que entra no projeto</span>
						<h2 id="bi-escopo-titulo">Cada análise responde a uma pergunta do seu negócio</h2>
						<p>O escopo é montado com você no diagnóstico gratuito, só com o que a sua empresa precisa. Abra cada frente para ver o que ela entrega.</p>
					</div>

					<div class="bi_escopo">
						<!-- name= deixa só uma frente aberta por vez (acordeão nativo, sem JS) -->
						<div class="bi_frentes">
							{solucao.escopo.map((e, i) => {
								const d = detalhes[e.item];
								return (
									<details class="bi_frente" name="bi-escopo" open={i === 0}>
										<summary>
											<span class="bi_frente-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
											<h3>
												<span class="bi_frente-nome">{e.item}</span>
												{d?.pergunta}
											</h3>
										</summary>
										{d && (
											<div class="bi_frente-corpo">
												<p>{d.texto}</p>
												<p class="bi_frente-entrega"><strong>Você recebe:</strong> {d.entrega}</p>
												{d.veja && <p>{d.veja.texto} <a href={sol(d.veja.slug).url}>{sol(d.veja.slug).nome}</a>.</p>}
												{e.href && <p><a href={e.href}>Conheça a consultoria →</a></p>}
											</div>
										)}
									</details>
								);
							})}
						</div>

						<div class="bi_entrega">
							<h3>Como o resultado chega até você</h3>
							<ul class="vantagens_list">
								{formatos.map((f) => (
									<li class="vantagens_list-item">
										<img src={CHECK} loading="lazy" alt="" />
										<span><strong>{f.titulo}.</strong> {f.texto}</span>
									</li>
								))}
							</ul>
							<a href="#formulario" class="button">Quero analisar meus dados</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</SolucaoLayout>

<style>
	/* Para quem é: 4 dores lado a lado no desktop */
	.bi_dores {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
		list-style: none;
	}

	.bi_aviso {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		margin-top: 1.5rem;
		padding: 1rem 1.5rem;
		background: var(--white);
		border: 1px solid var(--gray200);
		border-left: 4px solid var(--primary600);
		border-radius: var(--card-radius-md);
	}

	.bi_aviso p {
		color: var(--gray700);
		line-height: 1.5;
	}

	.bi_aviso strong {
		color: var(--gray900);
	}

	.bi_aviso .button-tertiary {
		padding-left: 0;
		padding-right: 0;
	}

	/* O que entra: perguntas (acordeão) à esquerda, formato da entrega à direita */
	.bi_escopo {
		display: grid;
		grid-template-columns: 1.35fr 0.9fr;
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: start;
	}

	.bi_frentes {
		border-top: 1px solid var(--border-hairline-dark);
	}

	.bi_frente {
		border-bottom: 1px solid var(--border-hairline-dark);
	}

	.bi_frente summary {
		display: grid;
		grid-template-columns: 1.5rem 1fr auto;
		gap: 1.25rem;
		align-items: center;
		padding: 1.5rem 0;
		list-style: none;
		cursor: pointer;
	}

	.bi_frente summary::-webkit-details-marker {
		display: none;
	}

	.bi_frente summary::after {
		content: "+";
		color: var(--primary200);
		font-size: 1.75rem;
		line-height: 1;
		transition: transform 0.3s var(--ease-out-expo);
	}

	.bi_frente[open] summary::after {
		transform: rotate(45deg);
	}

	.bi_frente-num {
		color: var(--graywarm300);
		font-size: 0.85rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.bi_frente[open] .bi_frente-num {
		color: var(--primary200);
	}

	.bi_frente h3 {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		color: var(--white);
		font-size: clamp(1.2rem, 1.8vw, 1.5rem);
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.015em;
		transition: color 0.2s;
	}

	.bi_frente summary:hover h3 {
		color: var(--primary100);
	}

	.bi_frente-nome {
		color: var(--primary200);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.bi_frente-corpo {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		max-width: 62ch;
		padding: 0 0 1.75rem 2.75rem;
		color: var(--graywarm300);
		line-height: 1.6;
	}

	.bi_frente-entrega {
		padding: 0.85rem 1rem;
		color: var(--white);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-hairline-dark);
		border-radius: 0.75rem;
	}

	.bi_frente-corpo a {
		color: var(--primary200);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.bi_entrega {
		position: sticky;
		top: calc(var(--nav-height) + 1.5rem);
		padding: clamp(1.5rem, 3vw, 2.25rem);
		background: var(--graywarm950);
		border: 1px solid var(--border-hairline-dark);
		border-radius: var(--card-radius-lg);
	}

	.bi_entrega h3 {
		color: var(--white);
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1.25;
	}

	.bi_entrega strong {
		color: var(--white);
	}

	.bi_entrega .button {
		width: 100%;
		margin-top: 1.75rem;
	}

	@media (max-width: 1024px) {
		.bi_dores {
			grid-template-columns: repeat(2, 1fr);
		}

		.bi_escopo {
			grid-template-columns: 1fr;
		}

		.bi_entrega {
			position: static;
		}
	}

	@media (max-width: 767px) {
		.bi_dores {
			grid-template-columns: 1fr;
		}

		.bi_frente summary {
			gap: 0.85rem;
		}

		.bi_frente-corpo {
			padding-left: 0;
		}
	}
</style>
