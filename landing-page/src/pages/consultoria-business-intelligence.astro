---
// Consultoria de Business Intelligence: landing com a estrutura e a copy de conteudo.ejfgv.com/business-intelligence-dados
// (PRO-19). Não usa o SolucaoLayout porque a ordem das seções é outra:
// hero → formulário → serviços → método → para quem é → CTA → quem somos → logos → depoimentos → números.
// Fotos da referência são de banco/IA: viram ImagemReservada. Logos, ícones e vídeos são os reais da EJ.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ImagemReservada from '../components/ImagemReservada.astro';
import LeadForm from '../components/LeadForm.astro';
import Metodo from '../components/Metodo.astro';
import CtaBanner from '../components/CtaBanner.astro';
import LogoWall from '../components/LogoWall.astro';
import Depoimentos from '../components/Depoimentos.astro';
import StatsStrip from '../components/StatsStrip.astro';
import { CDN, SITE, NUMEROS, SOLUCOES, DEPOIMENTOS, LOGOS_LP_BI, VIDEO_INSTITUCIONAL } from '../consts';

const solucao = SOLUCOES.find((s) => s.slug === 'consultoria-business-intelligence')!;
const CHECK = `${CDN}/671c665a9c8c2a788c93dd9b_check-icon.svg`;

// "Aprovada por grandes clientes" do hero: os mesmos 5 logos (monocromáticos) da referência.
const logosHero = [
	{ nome: 'TAM', src: `${CDN}/671c2d9484628304be3f5708_cliente%20Tam.svg` },
	{ nome: 'Samsung', src: `${CDN}/671c2d948395ab38d815c7d5_cliente%20Samsung.svg` },
	{ nome: 'Faber-Castell', src: `${CDN}/671c71ac84628304be5df12e_cliente%20faber%20castell.png` },
	{ nome: 'Vigor', src: `${CDN}/671c2d94c0a6d8654b98ddf9_cliente%20vigor.svg` },
	{ nome: 'Natura', src: `${CDN}/671c2d944980a82d647af545_cliente%20natura.svg` },
];

// Os 3 blocos de serviço, com texto, bullets e ícones da referência.
const servicos = [
	{
		icone: `${CDN}/672a37aed9b0d27f7453d2a3_novas-icon.svg`,
		titulo: 'Painéis de Dashboards & Agilidade para o seu Negócio',
		texto: 'Com dashboards personalizados e ferramentas estratégicas de monitoramento, você acompanha em tempo real as métricas mais relevantes para o seu negócio, promovendo ajustes rápidos e decisões embasadas. Nossas soluções integram a análise de dados à tomada de decisões diária, garantindo um processo contínuo de melhoria e otimização.',
		itens: [
			'Visibilidade completa através de dashboards intuitivos e personalizados',
			'Monitoramento em tempo real para ajustes estratégicos imediatos',
			'Integração entre análise de desempenho e execução estratégica',
			'Decisões embasadas com dados precisos e atualizados',
			'Clareza de dados para otimizar eficiência e crescimento',
		],
		foto: 'painel de dashboards em uso por um cliente',
	},
	{
		icone: `${CDN}/671c65bc0ece9976827460a6_speed-icon.svg`,
		titulo: 'Centralização e Organização de Dados',
		texto: 'Chega de dados espalhados em dez planilhas. Conectamos suas fontes — vendas, financeiro, operação — em uma estrutura única e confiável, que alimenta seus painéis automaticamente.',
		itens: [
			'Fim da consolidação manual de relatórios',
			'Uma única fonte de verdade para toda a empresa',
			'Experiência mais profissional para sua tomada de decisão',
			'Base pronta para análises e projeções dos seus recursos',
			'Dados atualizados sem retrabalho',
		],
		foto: 'base de dados centralizada de um projeto real',
	},
	{
		icone: `${CDN}/671c65bcad794eb512f4b579_visibility-icon.svg`,
		titulo: 'Indicadores e análise para decisão',
		texto: 'Definimos com você os KPIs que realmente importam pro seu negócio e transformamos números em leitura clara: onde está o gargalo, o que está crescendo, onde agir primeiro.',
		itens: [
			'KPIs certos para o seu segmento',
			'Comparativos e tendências, não só números soltos',
			'Identificação de gargalos antes que cresçam',
			'Relatórios que a diretoria entende em 5 minutos',
			'Clareza de dados para tomada de decisões',
		],
		foto: 'relatório de indicadores (KPIs) de um projeto real',
	},
];

// Método na ordem da jornada (a referência mostra a lista invertida); textos e "Solução" da referência.
const etapas = [
	{ nome: 'Contato', texto: 'Onde ocorre o primeiro alinhamento com o cliente com nosso time comercial.' },
	{ nome: 'Diagnóstico', texto: 'Identificamos dores, desafios e oportunidades através de uma reunião para diagnóstico.' },
	{ nome: 'Proposta', texto: 'Apresentação de soluções personalizadas para atender às necessidades da sua empresa.' },
	{ nome: 'Solução', texto: 'Escopo da consultoria estratégica que envolve a implementação das melhorias acordadas.' },
];

// Para quem é: os 4 perfis e ícones da referência.
const perfis = [
	{
		icone: `${CDN}/672a37ae2d2e20a904bf4c11_pme-icon.svg`,
		titulo: 'Para pequenas e médias empresas que tomam decisões sem dados centralizados',
		texto: 'Empresas que dependem de planilhas, sistemas desconectados ou controles manuais para acompanhar vendas, custos, operação e resultados.',
	},
	{
		icone: `${CDN}/672a37aed9b0d27f7453d2a3_novas-icon.svg`,
		titulo: 'Para negócios que perdem tempo com relatórios manuais',
		texto: 'Equipes que gastam horas organizando informações, atualizando arquivos e consolidando dados antes de conseguir analisar o desempenho da empresa.',
	},
	{
		icone: `${CDN}/672a37ae7609689739689139_transformacao-digital-icon.svg`,
		titulo: 'Para gestores que precisam tomar decisões com mais segurança',
		texto: 'Líderes que querem acompanhar indicadores importantes em painéis claros, visuais e atualizados, reduzindo achismos na tomada de decisão.',
	},
	{
		icone: `${CDN}/672a37adab06278a78107c4a_expansao-icon.svg`,
		titulo: 'Para empresas em crescimento que precisam de mais controle',
		texto: 'Negócios que estão aumentando sua operação e precisam visualizar gargalos, comparar resultados e acompanhar a evolução da empresa com mais clareza.',
	},
];

// Números e legendas da referência (os valores vêm de NUMEROS).
const numeros = [
	{ valor: `${NUMEROS.projetos}+`, count: NUMEROS.projetos, sufixo: '+', rotulo: 'Projetos atendidos', texto: `Colaboramos com mais de ${NUMEROS.projetos} projetos incríveis` },
	{ valor: String(NUMEROS.anos), count: NUMEROS.anos, rotulo: 'Anos de mercado', texto: 'Anos de experiência e suporte dos melhores professores do mercado.' },
	{ valor: String(NUMEROS.setores), count: NUMEROS.setores, rotulo: 'Setores atendidos', texto: 'Conhecimento profundo de segmentos e nichos.' },
	{ valor: String(NUMEROS.nps), count: NUMEROS.nps, rotulo: 'NPS score', texto: 'Orgulhoso índice de aprovação dos clientes.' },
];

const servico = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: solucao.nome,
	serviceType: solucao.nome,
	description: solucao.seo.descricao,
	url: new URL(solucao.url, SITE.url).href,
	provider: { '@type': 'ProfessionalService', name: SITE.nome, url: SITE.url },
};
---

<Layout titulo={solucao.seo.titulo} descricao={solucao.seo.descricao} ctaHref="#formulario" ctaRotulo="Quero obter resultados" jsonLd={servico}>
	<!-- 1. Hero: proposta de valor, CTA, logos de destaque e vídeo de introdução -->
	<PageHeader
		kicker="Consultoria de Business Intelligence para PMEs"
		titulo="Transforme planilhas em dashboards estratégicos — com consultoria orientada por professores da FGV."
		descricao="Se sua empresa ainda depende de planilhas desconectadas e horas de consolidação manual antes de cada decisão, está perdendo tempo e oportunidades. A EJFGV constrói dashboards e estruturas de BI sob medida para você acompanhar vendas, custos e resultados em tempo real — e decidir com dados."
	>
		<div class="hero_actions">
			<a href="#formulario" class="button is-button-large">Quero obter resultados</a>
		</div>
		<div class="home-hero_grandes-clientes">
			<p class="grandes-clientes_label">Aprovada por grandes clientes</p>
			<div class="grandes-clientes_row">
				{logosHero.map((logo) => <img src={logo.src} alt={logo.nome} class="grandes-clientes_logo" loading="eager" />)}
			</div>
		</div>
		<figure slot="midia" class="hero-photo-frame">
			<ImagemReservada classe="home-hero_image" escuro descricao="capa do vídeo de introdução da EJFGV" />
			<figcaption class="hero-photo-caption">
				<div class="hero-photo-caption-left">
					<span class="hero-photo-dot" aria-hidden="true"></span>
					<div>
						<strong>Conheça a EJFGV</strong>
						<span>Orientação de professores da FGV</span>
					</div>
				</div>
				<button type="button" class="hero-video-trigger" data-video={VIDEO_INSTITUCIONAL.url}>
					<svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z"></path></svg>
					Ver vídeo ({VIDEO_INSTITUCIONAL.duracao})
				</button>
			</figcaption>
		</figure>
	</PageHeader>

	<!-- 2. Formulário de captação logo depois do hero -->
	<LeadForm
		lp
		servico={solucao.slug}
		titulo="Agende um diagnóstico gratuito para transformar dados e tecnologia em vantagem competitiva para a sua empresa"
		texto="Após o preenchimento do formulário, um consultor da nossa equipe comercial entrará em contato com você por telefone para tirar suas dúvidas e fornecer mais detalhes sobre como podemos ajudar. Nossa equipe retorna em até 1 dia útil."
	/>

	<!-- 3. Serviços e benefícios: 3 blocos em Z e o fecho com CTA -->
	<section id="servicos" class="section_beneficios" aria-labelledby="servicos-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="beneficios_wrapper">
					<div class="beneficios_title">
						<h2 id="servicos-titulo">Nossos serviços de Consultoria em Business Intelligence (BI)</h2>
						<p class="bi_subtitulo">Decida com mais clareza e identifique gargalos antes que eles cresçam</p>
						<p>Consultoria focada nas suas necessidades. Soluções personalizadas para ganhar eficiência no dia a dia, acompanhar resultados e oferecer um atendimento mais ágil para seus clientes com uso de Inteligência Artificial (IA).</p>
					</div>

					<div class="beneficios_list">
						{servicos.map((s, i) => (
							<div class:list={['beneficios_item', { 'bi_item-invertido': i % 2 === 1 }]}>
								<div>
									<img src={s.icone} loading="lazy" alt="" class="vantagens_icon" />
									<h3>{s.titulo}</h3>
									<p>{s.texto}</p>
									<ul class="vantagens_list">
										{s.itens.map((item) => (
											<li class="vantagens_list-item">
												<img src={CHECK} loading="lazy" alt="" />
												<span>{item}</span>
											</li>
										))}
									</ul>
								</div>
								<ImagemReservada classe="vantagens_image" escuro descricao={s.foto} />
							</div>
						))}
					</div>

					<div class="beneficios_banner">
						<p class="beneficios-banner_title">Quanto tempo sua equipe perde reunindo planilhas antes de conseguir decidir?</p>
						<a href="#formulario" class="button-secondary">Quero uma análise dos meus dados</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. Metodologia -->
	<Metodo etapas={etapas} />

	<!-- 5. Dores / público-alvo -->
	<section id="para-quem" class="section_icp" aria-labelledby="para-quem-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="icp_header">
					<span class="eyebrow">Para quem é</span>
					<h2 id="para-quem-titulo">Sua empresa precisa de BI se os dados ainda não ajudam a decidir:</h2>
				</div>
				<ul class="bi_perfis">
					{perfis.map((p) => (
						<li class="icp_item">
							<img src={p.icone} loading="lazy" alt="" class="icp_icon" />
							<h3>{p.titulo}</h3>
							<p>{p.texto}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<!-- 6. CTA intermediário -->
	<CtaBanner
		titulo="Conquiste mais resultados com a EJFGV"
		texto="Preencha o formulário e converse com nossa equipe para entender como seus dados podem apoiar decisões melhores. Sem compromisso."
		href="#formulario"
		rotulo="Quero obter resultados →"
	/>

	<!-- 7. Quem somos / diferenciais -->
	<section id="quem-somos" class="section_icp" aria-labelledby="quem-somos-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="quem-somos_wrapper bi_quem-somos">
					<div>
						<span class="eyebrow">Quem somos?</span>
						<h2 id="quem-somos-titulo">Por que escolher a EJFGV?</h2>
						<p class="quem-somos_pillars">Custo-benefício, Inovação, Dedicação e Suporte acadêmico</p>
						<p class="quem-somos_copy">Somos uma consultoria estratégica composta por alunos de todos os cursos de graduação da FGV, focada em impulsionar o crescimento de pequenas e médias empresas, gerando impacto positivo na sociedade. Nosso objetivo é ambicioso: aspiramos alcançar a excelência de uma empresa sênior mesmo sendo jovens empreendedores.</p>
					</div>
					<ImagemReservada classe="vantagens_image" descricao="foto real da equipe EJFGV" />
				</div>
			</div>
		</div>
	</section>

	<!-- 8. Prova social I: grade extensa de logos -->
	<LogoWall titulo={`Aprovada por mais de ${NUMEROS.clientes} clientes`} logos={LOGOS_LP_BI} />

	<!-- 9. Prova social II: depoimentos em vídeo -->
	<section id="depoimentos" class="section_depoimentos" aria-labelledby="depoimentos-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="icp_header">
					<span class="eyebrow">Depoimentos</span>
					<h2 id="depoimentos-titulo">O que dizem os clientes da {SITE.nome}</h2>
				</div>
				<Depoimentos itens={DEPOIMENTOS.slice(0, 2)} />
			</div>
		</div>
	</section>

	<!-- 10. Track record -->
	<StatsStrip
		titulo="Estrutura Sólida, Resultados Inabaláveis"
		texto="Oferecemos consultoria de qualidade sênior com a agilidade de uma empresa júnior, unindo inovação e impacto social. Com práticas de mercado atualizadas e suporte técnico dos professores da Fundação Getulio Vargas, garantimos soluções modernas e resultados confiáveis."
		itens={numeros}
	/>
</Layout>

<style>
	.bi_subtitulo {
		margin-bottom: 0.5rem;
		color: var(--white);
		font-weight: 600;
	}

	/* Z-pattern: no desktop, a imagem do bloco do meio fica à esquerda */
	.bi_item-invertido > :global(.image-placeholder) {
		order: -1;
	}

	.bi_perfis {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
		list-style: none;
	}

	.bi_quem-somos {
		align-items: center;
		margin-bottom: 0;
	}

	.bi_quem-somos .quem-somos_pillars {
		margin-bottom: 1rem;
	}

	@media (max-width: 1024px) {
		.bi_item-invertido > :global(.image-placeholder) {
			order: 0;
		}

		.bi_perfis {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 767px) {
		.bi_perfis {
			grid-template-columns: 1fr;
		}
	}
</style>
