---
// Business Intelligence (PRO-20): a área entrega 3 frentes, que esta página apresenta juntas:
// dashboards em Power BI, sites com chatbot e integrações, e automações com n8n e IA.
// A moldura (credenciais, logos, depoimentos, método, FAQ, formulário) vem do SolucaoLayout; aqui ficam
// o H1 e a ilustração do cabeçalho, e o corpo: serviços → como as frentes se conectam → para quem é → números.
// Fontes: brief PRO-20 (frentes e posicionamento), consts.ts (NUMEROS, DEPOIMENTOS) e a LP original.
// As ilustrações (Mock) são decorativas e não trazem números: nada nelas é dado de cliente.
import SolucaoLayout from '../layouts/SolucaoLayout.astro';
import StatsStrip from '../components/StatsStrip.astro';
import Mock from '../components/solucoes/consultoria-business-intelligence/Mock.astro';
import { NUMEROS, SOLUCOES, DEPOIMENTOS } from '../consts';

const solucao = SOLUCOES.find((s) => s.slug === 'consultoria-business-intelligence')!;

const abertura = 'Painéis em Power BI para a gestão financeira e operacional, sites com chatbot que atendem e captam clientes, e automações com n8n e IA que tiram o trabalho repetitivo do caminho. Para pequenas e médias empresas.';

// Ícones de traço (SVG inline, mesmo estilo do Método), um por frente.
const icones = {
	dashboards: '<path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="5" rx="0.5"/><rect x="12" y="8" width="3" height="9" rx="0.5"/><rect x="17" y="5" width="3" height="12" rx="0.5"/>',
	sites: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M9 12.5h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-3l-2 2v-2H9a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1z"/>',
	automacoes: '<rect x="2" y="9" width="6" height="6" rx="1.5"/><rect x="16" y="3" width="6" height="6" rx="1.5"/><rect x="16" y="15" width="6" height="6" rx="1.5"/><path d="M8 12h2.5a2 2 0 0 0 2-2V8a2 2 0 0 1 2-2H16M10.5 12a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2H16"/>',
};
const CHECK = '<path d="M20 6 9 17l-5-5"/>';
const SETA = '<path d="M5 12h14M13 6l6 6-6 6"/>';

// As 3 frentes (brief PRO-20). Os ids casam com os links do escopo em consts.ts.
const frentes = [
	{
		id: 'dashboards',
		mock: 'dashboard' as const,
		icone: icones.dashboards,
		nome: 'Dashboards em Power BI',
		curto: 'Dashboards',
		area: 'Gestão financeira e operacional',
		texto: 'Para ver em uma tela como estão vendas, custos, metas, caixa e operação, e decidir com o número na mão, não no feeling.',
		entra: [
			'Base de dados organizada: planilhas e sistemas reunidos em um só lugar',
			'Indicadores (KPIs) definidos com você, do jeito que o seu negócio funciona',
			'Painéis interativos em Power BI, com filtros por período, produto ou equipe',
			'Visão financeira e operacional: vendas, custos, metas, caixa e operação',
			'Treinamento para o seu time manter e atualizar os painéis',
		],
		exemplos: [
			'Loja que acompanha vendas por produto e por vendedor',
			'Distribuidora que enxerga custo e margem de cada cliente',
			'Prestador de serviço que fecha o caixa do mês sem planilha paralela',
		],
		cta: 'Quero um dashboard',
	},
	{
		id: 'sites',
		mock: 'site' as const,
		icone: icones.sites,
		nome: 'Sites com chatbot e integrações',
		curto: 'Sites com chatbot',
		area: 'Presença digital, atendimento e captação',
		texto: 'Para ter um site moderno, que apresenta bem a empresa, funciona no celular e já conversa com quem chega, inclusive fora do horário comercial.',
		entra: [
			'Site moderno e responsivo, feito com apoio de IA',
			'Chatbot no site e no WhatsApp para atender e captar contatos, a integração principal',
			'Formulários de contato e orçamento que chegam direto para a sua equipe',
			'Outras integrações possíveis, definidas no diagnóstico conforme a sua rotina',
		],
		exemplos: [
			'Clínica que responde dúvidas frequentes pelo chatbot',
			'Prestador de serviço que recebe pedidos de orçamento no WhatsApp',
			'Empresa B2B que capta contatos qualificados pelo site',
		],
		cta: 'Quero um site com chatbot',
	},
	{
		id: 'automacoes',
		mock: 'fluxo' as const,
		icone: icones.automacoes,
		nome: 'Automações com n8n e IA',
		curto: 'Automações',
		area: 'Rotinas no automático',
		texto: 'Para tirar do caminho as tarefas repetitivas, como copiar dados, montar o mesmo relatório e mandar o mesmo aviso, e liberar o time para o que dá resultado.',
		entra: [
			'Mapeamento das tarefas repetitivas que mais tomam tempo da equipe',
			'Fluxos em n8n que conectam sistemas, planilhas e ERP',
			'IA (Claude) para ler, resumir, classificar e responder no meio do fluxo',
			'Relatórios automáticos que chegam prontos por e-mail ou WhatsApp',
			'Rotinas de atendimento e de operação automatizadas',
		],
		exemplos: [
			'Relatório de vendas que chega pronto toda segunda-feira',
			'Pedido do site que vira linha na planilha e aviso para a equipe',
			'E-mails de clientes separados por assunto com a ajuda da IA',
		],
		cta: 'Quero automatizar uma rotina',
	},
];
const frente = Object.fromEntries(frentes.map((f) => [f.id, f]));

// Como as frentes se conectam: um exemplo ilustrativo, sem números.
const conexao = [
	{ frente: frente.sites, titulo: 'O chatbot capta o contato', texto: 'Um visitante tira uma dúvida no site ou no WhatsApp, e o chatbot responde e pede o contato.' },
	{ frente: frente.automacoes, titulo: 'A automação registra e avisa', texto: 'O fluxo em n8n grava o contato na planilha ou no sistema e avisa a equipe na hora.' },
	{ frente: frente.dashboards, titulo: 'O dashboard mostra o funil', texto: 'No Power BI, você acompanha quantos contatos chegaram, de onde vieram e quantos viraram venda.' },
];

// Dores do dono de PME, cada uma ligada à frente que resolve.
const dores = [
	{ titulo: 'Os números estão espalhados', texto: 'Vendas numa planilha, financeiro em outra, estoque no sistema. Fechar o mês consome horas da equipe.', frente: frente.dashboards },
	{ titulo: 'As decisões saem no feeling', texto: 'Preço, compras e metas são definidos na intuição, sem olhar o histórico do próprio negócio.', frente: frente.dashboards },
	{ titulo: 'O site não traz clientes', texto: 'Está desatualizado, não funciona bem no celular e ninguém responde quem chega fora do horário.', frente: frente.sites },
	{ titulo: 'O time vive de tarefa repetitiva', texto: 'Copiar dados de um sistema para outro, montar o mesmo relatório toda semana, responder as mesmas perguntas.', frente: frente.automacoes },
];

// Rascunhos feitos só com o brief PRO-20 e fatos de consts.ts (validar: true). Preço não tem fonte: fica a preencher.
const faq = [
	{
		pergunta: 'Vocês trabalham com Power BI?',
		resposta: 'Sim. Os dashboards são feitos em Power BI: organizamos a base de dados, definimos os indicadores com você e montamos painéis interativos para acompanhar vendas, custos, metas, caixa e operação. No fim, treinamos o seu time para manter os painéis.',
		validar: true,
	},
	{
		pergunta: 'O site já vem com chatbot?',
		resposta: 'Pode vir. O chatbot é a principal integração dos sites que fazemos: ele atende e capta contatos no site e no WhatsApp. O que entra no seu site, como chatbot, formulários e outras integrações, é definido no diagnóstico, conforme o que a sua empresa precisa.',
		validar: true,
	},
	{
		pergunta: 'Que automações dá para fazer com n8n?',
		resposta: 'Fluxos que tiram tarefas repetitivas do caminho: relatórios que chegam prontos, dados que passam sozinhos entre sistemas, planilhas e ERP, avisos para a equipe e rotinas de atendimento. Quando faz sentido, usamos IA (Claude) no meio do fluxo para ler, resumir ou classificar informações.',
		validar: true,
	},
	{
		pergunta: 'Preciso trocar meus sistemas?',
		resposta: 'Não necessariamente. Partimos das planilhas, sistemas e ferramentas que você já usa e conectamos o que for preciso. Se alguma mudança fizer sentido, ela aparece no diagnóstico, antes da proposta.',
		validar: true,
	},
	{
		pergunta: 'Preciso ter os dados organizados antes de contratar?',
		resposta: 'Não. Muitas empresas chegam com planilhas soltas ou sistemas desconectados. Nesses casos, o projeto começa organizando os dados em uma base única e confiável.',
		validar: true,
	},
	{
		pergunta: 'Como o projeto começa? O diagnóstico é gratuito?',
		resposta: 'Sim, o diagnóstico é gratuito. Depois do primeiro contato com o nosso time comercial, fazemos uma reunião de diagnóstico para identificar dores, desafios e oportunidades. Em seguida, apresentamos uma proposta com escopo, prazos e soluções personalizadas para a sua empresa.',
		validar: true,
	},
	{
		pergunta: 'Quanto tempo dura um projeto?',
		resposta: `Os projetos da EJFGV têm em média ${NUMEROS.prazoMedioMeses} meses. O prazo de cada projeto é apresentado na proposta, junto com o escopo.`,
		validar: true,
	},
	{ pergunta: 'Quanto custa um dashboard, um site ou uma automação?' },
];
---

<SolucaoLayout
	solucao={solucao}
	titulo="Dados, sites e automações para decidir e operar melhor"
	abertura={abertura}
	faq={faq}
	ctaRotulo="Agendar diagnóstico"
	depoimentos={DEPOIMENTOS.slice(0, 2)}
>
	<Fragment slot="titulo">Dados, sites e automações <span class="highlight-purpose">para decidir e operar melhor</span></Fragment>
	<a slot="acoes" href="#servicos" class="button-secondary is-button-large bi_cta-sec">Ver os serviços</a>

	<!-- Ilustração própria das 3 frentes juntas, em camadas -->
	<figure slot="midia" class="bi_hero">
		<div class="bi_palco">
			<div class="bi_camada is-dashboard">
				<span class="bi_selo"><svg viewBox="0 0 24 24" set:html={icones.dashboards} />Power BI</span>
				<Mock tipo="dashboard" />
			</div>
			<div class="bi_camada is-site">
				<span class="bi_selo"><svg viewBox="0 0 24 24" set:html={icones.sites} />Site + chatbot</span>
				<Mock tipo="site" />
			</div>
			<div class="bi_camada is-fluxo">
				<span class="bi_selo"><svg viewBox="0 0 24 24" set:html={icones.automacoes} />n8n + IA</span>
				<Mock tipo="fluxo" />
			</div>
		</div>
		<figcaption class="bi_legenda">Ilustração das três frentes: painel, site com chatbot e fluxo de automação.</figcaption>
	</figure>

	<!-- 1. Serviços: as 3 frentes em cartões grandes -->
	<section id="servicos" class="bi_servicos" aria-labelledby="bi-servicos-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="bi_cabeca">
					<span class="eyebrow">O que fazemos</span>
					<h2 id="bi-servicos-titulo">Três frentes para a sua empresa decidir e operar melhor</h2>
					<p>Cada frente resolve um problema do dia a dia. O que entra no seu projeto é definido com você no diagnóstico gratuito.</p>
				</div>

				<nav class="bi_atalhos" aria-label="Ir para um serviço">
					{frentes.map((f) => (
						<a href={`#${f.id}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={f.icone} />{f.nome}</a>
					))}
				</nav>

				<div class="bi_frentes">
					{frentes.map((f) => (
						<article id={f.id} class="bi_frente" aria-labelledby={`${f.id}-titulo`}>
							<div class="bi_frente-texto">
								<span class="bi_icone" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={f.icone} /></span>
								<span class="bi_area">{f.area}</span>
								<h3 id={`${f.id}-titulo`}>{f.nome}</h3>
								<p class="bi_para">{f.texto}</p>

								<h4>O que entra</h4>
								<ul class="bi_lista">
									{f.entra.map((item) => (
										<li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={CHECK} />{item}</li>
									))}
								</ul>

								<h4>Exemplos de uso em PMEs</h4>
								<ul class="bi_exemplos">
									{f.exemplos.map((e) => <li>{e}</li>)}
								</ul>

								<a href="#formulario" class="bi_link">{f.cta}<svg viewBox="0 0 24 24" aria-hidden="true" set:html={SETA} /></a>
							</div>
							<figure class="bi_frente-visual">
								<Mock tipo={f.mock} />
								<figcaption>Ilustração</figcaption>
							</figure>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Como as frentes se conectam (exemplo ilustrativo) -->
	<section class="bi_conexao" aria-labelledby="bi-conexao-titulo">
		<div class="hero_background" aria-hidden="true"></div>
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="bi_cabeca">
					<span class="eyebrow">Como combinamos as frentes</span>
					<h2 id="bi-conexao-titulo">Juntas, uma frente alimenta a outra</h2>
					<p>Cada frente funciona sozinha. Combinadas, o contato que chega pelo site vira informação para decidir.</p>
				</div>

				<p class="bi_tag-exemplo">Exemplo ilustrativo</p>
				<ol class="bi_fluxo">
					{conexao.map((passo) => (
						<li class="bi_passo">
							<span class="bi_icone" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={passo.frente.icone} /></span>
							<a class="bi_passo-frente" href={`#${passo.frente.id}`}>{passo.frente.nome}</a>
							<h3>{passo.titulo}</h3>
							<p>{passo.texto}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- 3. Para quem é: dores ligadas à frente que resolve -->
	<section id="para-quem" class="bi_para-quem" aria-labelledby="bi-para-quem-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="icp_header">
					<span class="eyebrow">Para quem é</span>
					<h2 id="bi-para-quem-titulo">Para pequenas e médias empresas que perdem tempo, cliente ou clareza</h2>
				</div>
				<ul class="bi_dores">
					{dores.map((d) => (
						<li class="bi_dor">
							<span class="bi_icone is-claro" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={d.frente.icone} /></span>
							<h3>{d.titulo}</h3>
							<p>{d.texto}</p>
							<a href={`#${d.frente.id}`}>Solução: {d.frente.curto}<svg viewBox="0 0 24 24" aria-hidden="true" set:html={SETA} /></a>
						</li>
					))}
				</ul>
				<div class="bi_aviso">
					<p><strong>Não precisa trocar seus sistemas nem chegar com tudo organizado.</strong> Partimos das planilhas e ferramentas que você já usa.</p>
					<a href="#formulario" class="button-tertiary">Contar como funciona hoje →</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. Números da EJFGV (os mesmos do resto do site) -->
	<StatsStrip />
</SolucaoLayout>

<style>
	/* ---------- Cabeçalho ---------- */
	.bi_cta-sec {
		background: transparent;
		border-color: var(--border-hairline-dark);
	}

	.bi_cta-sec:hover {
		background: rgba(249, 255, 252, 0.08);
		border-color: rgba(249, 255, 252, 0.3);
	}

	.bi_hero {
		position: relative;
		margin-top: 1.5rem;
	}

	@media (min-width: 1025px) {
		:global(.page-header_wrapper:has(.bi_hero)) {
			grid-template-columns: 0.92fr 1.08fr;
		}
	}

	:global(.page-header_wrapper:has(.bi_hero) .hero_heading) {
		font-size: clamp(2.5rem, 4.6vw, 3.9rem);
	}

	/* Brilho laranja discreto atrás das camadas */
	.bi_hero::before {
		content: "";
		position: absolute;
		inset: 12% 8%;
		z-index: 0;
		background: radial-gradient(closest-side, rgba(227, 142, 51, 0.28), transparent);
		filter: blur(30px);
	}

	/* Palco proporcional: as camadas usam % para manter a composição em qualquer largura */
	.bi_palco {
		position: relative;
		z-index: 1;
		aspect-ratio: 1 / 0.94;
	}

	.bi_camada {
		position: absolute;
		animation: bi-entra 0.9s var(--ease-out-expo) both;
		transition: transform 0.6s var(--ease-out-expo);
	}

	.bi_camada.is-dashboard {
		top: 0;
		left: 0;
		width: 76%;
	}

	.bi_camada.is-site {
		top: 27%;
		right: 0;
		width: 58%;
		z-index: 2;
		animation-delay: 0.15s;
	}

	.bi_camada.is-fluxo {
		bottom: 0;
		left: 4%;
		width: 64%;
		z-index: 3;
		animation-delay: 0.3s;
	}

	.bi_camada :global(.mock_frame) {
		aspect-ratio: 16 / 11;
	}

	.bi_camada.is-site :global(.mock_frame) {
		aspect-ratio: 4 / 3.4;
	}

	.bi_camada.is-fluxo :global(.mock_frame) {
		aspect-ratio: 16 / 7.6;
	}

	.bi_camada.is-fluxo :global(.fluxo) {
		min-height: 0;
	}

	/* No hover, as camadas se afastam um pouco (profundidade) */
	.bi_hero:hover .is-dashboard {
		transform: translate(-1.5%, -1.5%);
	}

	.bi_hero:hover .is-site {
		transform: translate(1.5%, -1%);
	}

	.bi_hero:hover .is-fluxo {
		transform: translate(-1%, 1.5%);
	}

	.bi_selo {
		position: absolute;
		bottom: calc(100% - 0.4rem);
		left: 1rem;
		z-index: 4;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem;
		color: var(--brand-chumbo);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		white-space: nowrap;
		background: var(--primary600);
		border-radius: 999px;
		box-shadow: 0 6px 16px -6px rgba(37, 40, 50, 0.5);
	}

	.is-site .bi_selo {
		right: 1rem;
		left: auto;
	}

	.bi_selo svg,
	.bi_atalhos svg,
	.bi_icone svg,
	.bi_lista svg,
	.bi_link svg,
	.bi_dor a svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.bi_selo svg {
		width: 0.95rem;
		height: 0.95rem;
	}

	.bi_legenda {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---------- Títulos de seção ---------- */
	/* Laranja escurecido (primary800) nos rótulos pequenos em fundo claro: passa o AA */
	.bi_servicos .eyebrow,
	.bi_para-quem .eyebrow {
		color: var(--primary800);
	}

	.bi_cabeca {
		max-width: 46rem;
		margin: 0 auto clamp(2rem, 4vw, 3rem);
		text-align: center;
	}

	.bi_cabeca h2 {
		margin-top: 0.35rem;
		color: var(--gray900);
		font-size: clamp(1.75rem, 3.2vw, 2.75rem);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.bi_cabeca p {
		margin-top: 1rem;
		color: var(--gray600);
		font-size: 1.0625rem;
		line-height: 1.6;
		text-wrap: pretty;
	}

	/* ---------- 1. Serviços ---------- */
	.bi_atalhos {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		margin-bottom: clamp(2rem, 4vw, 3.5rem);
	}

	.bi_atalhos a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1.1rem;
		color: var(--gray900);
		font-size: 0.9rem;
		font-weight: 700;
		background: var(--white);
		border: 1px solid var(--gray200);
		border-radius: 999px;
		transition: border-color 0.25s, color 0.25s, transform 0.25s var(--ease-out-expo);
	}

	.bi_atalhos a:hover {
		color: var(--primary800);
		border-color: var(--primary600);
		transform: translateY(-1px);
	}

	.bi_atalhos svg {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--primary700);
	}

	.bi_frentes {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 3vw, 2.5rem);
	}

	.bi_frente {
		display: grid;
		grid-template-columns: 1fr 1.08fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
		padding: clamp(1.5rem, 3.5vw, 3rem);
		scroll-margin-top: calc(var(--nav-height) + 1rem);
		background: var(--white);
		border: 1px solid var(--gray200);
		border-radius: var(--card-radius-xl);
		box-shadow: 0 1px 2px rgba(37, 40, 50, 0.04), 0 24px 48px -32px rgba(37, 40, 50, 0.25);
	}

	/* Ritmo em Z: a ilustração alterna de lado */
	.bi_frente:nth-child(even) .bi_frente-visual {
		order: -1;
	}

	.bi_icone {
		display: grid;
