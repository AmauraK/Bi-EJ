---
// Consultoria Financeira: props do SolucaoLayout e o corpo próprio (slot padrão) em duas seções:
// 1. Para quem é: as perguntas do dono (base: solucao.quandoFazSentido), cada uma com âncora para a frente que a responde.
// 2. O que entra no projeto: cada item de solucao.escopo com uma frase do que é entregue, sem jargão.
// Cases, números, credenciais, método, FAQ e formulário já vêm do layout. Fontes: consts.ts (descrição, escopo, cases).
import SolucaoLayout from '../layouts/SolucaoLayout.astro';
import { SITE, NUMEROS, SOLUCOES } from '../consts';

const solucao = SOLUCOES.find((s) => s.slug === 'consultoria-financeira')!;

const abertura = 'Organizamos o caixa, cortamos custos, acertamos o preço e mostramos se um investimento vale a pena. Para donos de pequenas e médias empresas que querem decidir com números, não no achismo.';

// O que cada frente entrega. Chave = item de solucao.escopo (consts.ts).
const entregas: Record<string, { id: string; texto: string; link?: { texto: string; rotulo: string; href: string } }> = {
	'Gestão de caixa': {
		id: 'financeira-caixa',
		texto: 'Organizamos as entradas e saídas para você saber quanto dinheiro tem e evitar aperto no fim do mês.',
	},
	'Corte de custos': {
		id: 'financeira-custos',
		texto: 'Mapeamos os gastos e apontamos onde dá para economizar, para sobrar mais em cada venda.',
	},
	'Precificação': {
		id: 'financeira-precificacao',
		texto: 'Calculamos quanto cobrar para o preço ser competitivo e cobrir as despesas do negócio.',
	},
	'Análise financeira': {
		id: 'financeira-analise',
		texto: 'Lemos os demonstrativos de receitas, despesas e resultado e montamos relatórios de gestão para acompanhar a saúde da empresa.',
		link: { texto: 'Quer esses números em um painel?', rotulo: 'Conheça a Consultoria de Business Intelligence', href: '/consultoria-business-intelligence/' },
	},
	'Modelagem financeira': {
		id: 'financeira-modelagem',
		texto: 'Antes de uma decisão grande, projetamos a rentabilidade e o payback do investimento: em quanto tempo o dinheiro volta.',
	},
	'Valuation e pitch para investidores': {
		id: 'financeira-valuation',
		texto: 'Estimamos quanto vale a empresa e preparamos o pitch, a apresentação do negócio para investidores.',
		link: { texto: 'Ainda vai tirar a ideia do papel?', rotulo: 'Conheça o Plano de Negócios', href: '/plano-de-negocios/' },
	},
};

const frentes = solucao.escopo.map((e) => {
	const entrega = entregas[e.item];
	if (!entrega) throw new Error(`Frente "${e.item}" (consts.ts) sem texto em consultoria-financeira.astro`);
	return { ...e, ...entrega };
});

// Os dois momentos de solucao.quandoFazSentido, em perguntas do dia a dia. Cada pergunta leva à primeira frente.
const momentos = [
	{
		titulo: 'Controlar melhor as finanças',
		texto: 'Para entender a saúde da empresa e melhorar as margens.',
		perguntas: [
			{ pergunta: 'Para onde está indo o dinheiro da empresa?', frentes: ['Gestão de caixa', 'Corte de custos', 'Análise financeira'] },
			{ pergunta: 'Quanto devo cobrar pelo meu produto ou serviço?', frentes: ['Precificação'] },
		],
	},
	{
		titulo: 'Entender rentabilidade e valor',
		texto: 'Para decidir um investimento grande ou se preparar para buscar investidores.',
		perguntas: [
			{ pergunta: 'Vale a pena fazer este investimento?', frentes: ['Modelagem financeira'] },
			{ pergunta: 'Quanto vale a minha empresa?', frentes: ['Valuation e pitch para investidores'] },
		],
	},
];

const faq = [
	{
		pergunta: 'O que a Consultoria Financeira da EJFGV faz?',
		resposta: `${solucao.descricao} O escopo de cada projeto é definido na proposta, depois de entendermos o seu momento, e pode incluir gestão de caixa, corte de custos, precificação, análise financeira, modelagem financeira, valuation e pitch para investidores.`,
	},
	{
		pergunta: 'A Consultoria Financeira serve para o meu setor?',
		resposta: `A ${SITE.nome} é focada no crescimento de pequenas e médias empresas e já atendeu empresas de ${NUMEROS.setores} setores, de diferentes portes. Na Consultoria Financeira, há cases de agronegócio, de eventos e de publicidade e propaganda.`,
	},
	{
		pergunta: 'Quem faz o projeto?',
		resposta: `Alunos de todos os cursos de graduação da FGV, com orientação de professores da FGV. A ${SITE.nome} é a ${SITE.nomeCompleto}, a primeira empresa júnior da América Latina, fundada em ${NUMEROS.fundacao}, com mais de ${NUMEROS.projetos} projetos entregues.`,
	},
	{
		// Média de todos os projetos (citação de Thiago Caruso, legado): confirmar se vale para a Financeira.
		pergunta: 'Quanto tempo dura um projeto?',
		resposta: `Os projetos da ${SITE.nome} têm, em média, ${NUMEROS.prazoMedioMeses} meses. Nesse período, buscamos o maior alinhamento possível com você, em um processo intenso de cocriação.`,
		validar: true,
	},
	{
		pergunta: 'O diagnóstico tem custo?',
		resposta: `Não. O primeiro passo é uma reunião de diagnóstico gratuita e sem compromisso, para identificar dores, desafios e oportunidades. Depois, apresentamos uma proposta com escopo, prazos e soluções personalizadas para a realidade da sua empresa. Nossa equipe retorna em até ${NUMEROS.retornoDiasUteis} dia útil.`,
	},
	{ pergunta: 'Quanto custa a Consultoria Financeira?' },
];
---

<SolucaoLayout
	solucao={solucao}
	abertura={abertura}
	faq={faq}
	kicker="Caixa · Custos · Preço · Valuation"
>
	<!-- 1. Para quem é: a pergunta do dono leva à frente que a responde -->
	<section class="section_icp" aria-labelledby="financeira-para-quem">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="icp_header">
					<span class="eyebrow">Para quem é</span>
					<h2 id="financeira-para-quem">{solucao.chamada}</h2>
					<p class="financeira_lead">Escolha a sua pergunta e veja como o projeto responde.</p>
				</div>
				<div class="financeira_momentos">
					{momentos.map((m) => (
						<article class="icp_item financeira_momento">
							<h3>{m.titulo}</h3>
							<p>{m.texto}</p>
							<ul class="financeira_perguntas">
								{m.perguntas.map((p) => (
									<li>
										<a href={`#${entregas[p.frentes[0]].id}`}>
											<span class="financeira_pergunta">{p.pergunta}</span>
											<span class="financeira_frentes">{p.frentes.join(' · ')}</span>
											<span class="financeira_seta" aria-hidden="true">↓</span>
										</a>
									</li>
								))}
							</ul>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 2. O que entra no projeto: uma frase por frente do escopo -->
	<section class="section_beneficios" aria-labelledby="financeira-escopo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="beneficios_title">
					<span class="eyebrow">O que entra no projeto</span>
					<h2 id="financeira-escopo">Do caixa do mês ao valor da empresa</h2>
					<p>Você não precisa contratar tudo: na proposta, combinamos só as frentes que fazem sentido para o seu momento.</p>
				</div>
				<ol class="financeira_grid">
					{frentes.map((f, i) => (
						<li id={f.id} class="frente_mini-card financeira_frente">
							<span class="financeira_numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<h3>{f.item}</h3>
							<p>{f.texto}</p>
							{f.link && <p class="financeira_link">{f.link.texto} <a href={f.link.href}>{f.link.rotulo}</a></p>}
						</li>
					))}
				</ol>
				<div class="financeira_cta">
					<p>Não sabe por onde começar? O diagnóstico gratuito mostra quais frentes fazem diferença na sua empresa.</p>
					<a href="#formulario" class="button">Solicite seu diagnóstico gratuito</a>
				</div>
			</div>
		</div>
	</section>
</SolucaoLayout>

<style>
	.financeira_lead {
		margin-top: 0.75rem;
		color: var(--gray600);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	/* 1. Momentos e perguntas */
	.financeira_momentos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.financeira_momento {
		padding: clamp(1.5rem, 3vw, 2.25rem);
	}

	.financeira_momento h3 {
		font-size: clamp(1.2rem, 1.8vw, 1.4rem);
		font-weight: 800;
		letter-spacing: -0.015em;
	}

	.financeira_momento > p {
		font-size: 0.95rem;
	}

	.financeira_perguntas {
		margin-top: 1rem;
		list-style: none;
	}

	.financeira_perguntas a {
		display: grid;
		grid-template-columns: 1fr auto;
		column-gap: 1rem;
		padding: 1.1rem 0;
		border-top: 1px solid var(--gray200);
	}

	.financeira_pergunta {
		color: var(--gray900);
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		font-weight: 700;
		line-height: 1.3;
		transition: color 0.2s;
	}

	.financeira_frentes {
		grid-row: 2;
		margin-top: 0.3rem;
		color: var(--gray500);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.financeira_seta {
		grid-row: 1 / span 2;
		align-self: center;
		color: var(--primary600);
		font-size: 1.25rem;
		font-weight: 700;
		transition: transform 0.25s var(--ease-out-expo);
	}

	.financeira_perguntas a:hover .financeira_pergunta,
	.financeira_perguntas a:focus-visible .financeira_pergunta {
		color: var(--primary700);
	}

	.financeira_perguntas a:hover .financeira_seta {
		transform: translateY(3px);
	}

	/* 2. Frentes do escopo (seção escura) */
	.financeira_grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-top: clamp(2.5rem, 4vw, 3.5rem);
		list-style: none;
	}

	.financeira_frente {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: clamp(1.5rem, 2.5vw, 2rem);
		scroll-margin-top: calc(var(--nav-height) + 1.5rem);
	}

	.financeira_frente .financeira_numero {
		margin: 0;
		color: var(--graywarm600);
		font-size: 2rem;
		font-weight: 900;
		letter-spacing: -0.03em;
		line-height: 1;
		transition: color 0.25s;
	}

	.financeira_frente h3 {
		color: var(--white);
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.financeira_frente p {
		font-size: 0.95rem;
	}

	/* Frente aberta pela pergunta da seção 1 (âncora) fica em destaque */
	.financeira_frente:hover .financeira_numero,
	.financeira_frente:target .financeira_numero {
		color: var(--primary200);
	}

	.financeira_frente:target {
		border-color: var(--primary500);
	}

	.financeira_link {
		margin-top: auto;
		padding-top: 0.5rem;
	}

	/* Link dentro do texto: sublinhado para não depender só da cor */
	.financeira_link a {
		color: var(--primary200);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.financeira_cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-top: clamp(2rem, 4vw, 3rem);
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--border-hairline-dark);
	}

	.financeira_cta p {
		max-width: 36rem;
		color: var(--white);
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		font-weight: 700;
		line-height: 1.4;
	}

	@media (max-width: 1024px) {
		.financeira_grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 767px) {
		.financeira_momentos,
		.financeira_grid {
			grid-template-columns: 1fr;
		}

		.financeira_cta {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
