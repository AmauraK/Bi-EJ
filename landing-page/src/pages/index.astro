---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import LeadForm from '../components/LeadForm.astro';
---

<Layout
  titulo="EJFGV — Consultoria Estratégica feita por alunos da FGV"
  descricao="A EJFGV é a Empresa Júnior da Fundação Getulio Vargas em São Paulo. Desde 1988, entregamos +800 projetos sob medida em Estratégia, Marketing, Finanças, Operações e Business Intelligence."
  canonicalPath="/"
  ctaHref="#formulario"
>
  <PageHeader
    eyebrow="A primeira Empresa Júnior da América Latina · desde 1988"
    titulo="Consultoria estratégica feita por alunos da FGV"
    lead="A EJFGV é a Empresa Júnior da Fundação Getulio Vargas em São Paulo."
    acoes={[
      { rotulo: 'Solicite seu diagnóstico gratuito', href: '#formulario', grande: true },
    ]}
  />
  <section id="solucoes" class="padding-section-medium">
    <div class="page-padding">
      <div class="container-large">
        <h2>Nossas Soluções</h2>
      </div>
    </div>
  </section>
  <LeadForm />
</Layout>
