---
// Plano de Negócios (/plano-de-negocios/). O SolucaoLayout monta a moldura (cabeçalho, números, cases, método,
// FAQ e formulário); aqui ficam as props e o corpo próprio, em três seções:
// 1. Para quem é: as dúvidas de quem empreende, cada uma com o resultado que o plano entrega.
// 2. O que entra no projeto: solucao.escopo nas duas fases de solucao.quandoFazSentido, com o MVP explicado sem
//    jargão e cada plano levando à consultoria da área (docx: serviço completo e navegação cruzada).
// 3. Primeiro o mercado: por que o plano começa pela pesquisa (docx: diferencial, expertise e metodologia).
// Fontes: consts.ts (SOLUCOES, CASES, NUMEROS, CITACAO_PROJETO) e o docx.
import SolucaoLayout from '../layouts/SolucaoLayout.astro';
import Foto from '../components/Foto.astro';
import { SITE, NUMEROS, SOLUCOES, CASES, CITACAO_PROJETO, FOTOS } from '../consts';

const solucao = SOLUCOES.find((s) => s.slug === 'plano-de-negocios')!;
const caseAudio = CASES.find((c) => c.slug.includes('empresa-de-audio'))!;
const nomeDe = (url: string) => SOLUCOES.find((s) => s.url === url)!.nome;

// Ícones de traço (SVG inline, mesmo desenho dos ícones do Método).
const ICONES = {
	ideia: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1.1 1.2 1.1 2V16h5v-.2c0-.8.5-1.5 1.1-2A6 6 0 0 0 12 3z"/>',
	inicio: '<path d="M5 21V4"/><path d="M5 4h11l-2 4 2 4H5"/>',
	empresa: '<path d="M3 21h18"/><path d="M5 21V8l7-4 7 4v13"/><path d="M12 11v6M9 14h6"/>',
	investidor: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M12 16v4M8 20h8"/><path d="m7 12 3-3 2 2 4-4"/>',
	check: '<path d="m5 12 5 5 9-10"/>',
};

// 1. Para quem é: a dúvida, na voz do dono, e o que ele leva do projeto.
const dores = [
	{ icone: ICONES.ideia, dor: '“Tenho uma ideia, mas não sei se alguém vai comprar.”', resposta: 'Você descobre se existe demanda antes de colocar dinheiro no negócio.' },
	{ icone: ICONES.inicio, dor: '“A ideia se provou. E agora, por onde eu começo?”', resposta: 'Você sai com o caminho para começar a operar: como a empresa vai funcionar, quanto investir e como vender.' },
	{ icone: ICONES.empresa, dor: '“Minha empresa já existe e quero lançar um novo negócio.”', resposta: 'O plano também serve para empresas consolidadas. Foi assim com uma empresa de áudio:', caso: caseAudio },
	{ icone: ICONES.investidor, dor: '“Vou buscar investimento e preciso chegar preparado.”', resposta: 'Você apresenta aos investidores uma estratégia clara, com os números do negócio.' },
];

// 2. O que cada frente entrega, em linguagem simples. Chave = item de solucao.escopo (consts.ts).
const entregas: Record<string, { titulo?: string; texto: string }> = {
	'Ideação, viabilidade e pesquisa de mercado': {
		titulo: 'Pesquisa de mercado e viabilidade',
		texto: 'Organizamos a ideia, analisamos se ela é viável e pesquisamos o mercado para saber se existe público para o que você quer vender.',
	},
	'Elaboração e acompanhamento de MVP': {
		titulo: 'Teste da ideia na prática (MVP)',
		texto: 'MVP quer dizer “produto mínimo viável”: uma primeira versão, simples, do seu produto ou serviço. Montamos e acompanhamos esse teste com você, antes do investimento maior.',
	},
	'Plano operacional': { texto: 'Como a empresa funciona no dia a dia: atividades iniciais, processos e quem faz o quê, para começar sem improviso.' },
	'Plano financeiro': { texto: 'Os números na ponta do lápis: quanto investir, quanto custa manter a operação e se o negócio se paga.' },
	'Plano de marketing': { texto: 'Como o seu público vai conhecer e escolher a sua marca, com ações de marketing tradicional e digital.' },
	'Apresentação para investidores': { texto: 'Se o próximo passo é captar recursos, o plano vira uma apresentação clara, com a estratégia e os números do negócio.' },
};

// As duas fases são os dois momentos de solucao.quandoFazSentido: testar a ideia e, depois, consolidar o negócio.
const [testar, consolidar] = solucao.quandoFazSentido;
const fases = [
	{ titulo: testar.titulo, pergunta: 'Existe mercado para a sua ideia?', itens: ['Ideação, viabilidade e pesquisa de mercado', 'Elaboração e acompanhamento de MVP'] },
	{ titulo: consolidar.titulo, pergunta: 'Comprovada a viabilidade: como a empresa vai funcionar, fechar as contas e vender?', itens: ['Plano operacional', 'Plano financeiro', 'Plano de marketing', 'Apresentação para investidores'] },
].map((fase) => ({
	...fase,
	frentes: fase.itens.map((item) => {
		const { href } = solucao.escopo.find((e) => e.item === item)!;
		return { titulo: entregas[item].titulo ?? item, texto: entregas[item].texto, href, consultoria: href && nomeDe(href) };
	}),
}));

// Cabeçalho: o caminho do projeto, da ideia ao plano (solucao.escopo e abertura, sem prometer nada a mais).
const etapasHero = ['Ideia e viabilidade', 'Pesquisa de mercado', 'Teste com MVP', 'Operação, finanças e marketing'];

// 3. Por que começar pelo mercado (diferencial e expertise); a metodologia vem na citação.
const motivos = [
	{ titulo: 'Você arrisca menos', texto: 'Descobre se a ideia tem público antes de gastar com estrutura.' },
	{ titulo: 'Os números saem da realidade', texto: 'As contas do plano financeiro e as ações de marketing partem do que a pesquisa e o teste mostraram, e não de um palpite.' },
	{ titulo: 'Especialistas em cada parte', texto: `A ${SITE.nome} também tem consultorias dedicadas a mercado, finanças, operação e Business Intelligence. Esse conhecimento entra em cada frente do seu plano.` },
];
---

<SolucaoLayout
	solucao={solucao}
	titulo="Plano de Negócios completo para tirar sua ideia do papel"
	kicker="Para ideias novas e empresas consolidadas"
	hero="arco"
	abertura="Pesquisamos o mercado, testamos a ideia e planejamos operação, finanças e marketing em um só projeto. Para quem vai abrir uma empresa ou lançar um novo negócio."
	faq={[
		{
			pergunta: 'O que é um plano de negócios?',
			resposta: `É o mapa do seu negócio: mostra se existe mercado, como a operação vai funcionar, se as contas fecham e como o produto ou serviço vai chegar aos clientes. O da ${SITE.nome} também define direcionadores de curto a longo prazo, como missão, visão e valores.`,
			validar: true,
		},
		{
			pergunta: `Minha ideia ainda não saiu do papel. A ${SITE.nome} pode ajudar?`,
			resposta: 'Sim. O projeto pode começar do zero: organizamos a ideia, analisamos se ela é viável e pesquisamos o mercado. Depois, testamos com um MVP, uma primeira versão simples do produto ou serviço, antes do investimento maior.',
			validar: true,
		},
		{
			pergunta: 'Preciso contratar as consultorias financeira, operacional e de marketing à parte?',
			resposta: 'Não. Os planos operacional, financeiro e de marketing fazem parte do Plano de Negócios. As consultorias dedicadas são para quem quer ir mais fundo em uma área, como corte de custos ou mapeamento de processos.',
			validar: true,
		},
		{
			pergunta: 'Quanto tempo leva um plano de negócios?',
			resposta: `Os projetos da ${SITE.nome} duram, em média, ${NUMEROS.prazoMedioMeses} meses. O prazo de cada plano é definido na proposta, depois do diagnóstico gratuito.`,
			validar: true,
		},
		{
			pergunta: 'Quanto custa um plano de negócios?',
			resposta: 'Depende do escopo do seu plano. O valor é apresentado na proposta, depois de um diagnóstico gratuito para entender o momento do seu negócio.',
			validar: true,
		},
	]}
>
	<Fragment slot="titulo">Plano de Negócios completo <span class="highlight-purpose">para tirar sua ideia do papel</span></Fragment>

	<!-- Cabeçalho: as consultoras com o plano na mesa, em arco, e as etapas do projeto atravessando a foto -->
	<figure slot="midia" class="pn_hero">
		<div class="pn_arco">
			<Foto foto={FOTOS.consultorasDocumento} sizes="(min-width: 1025px) 480px, 100vw" />
		</div>
		<ol class="pn_etapas" aria-label="Do projeto: da ideia ao plano">
			{etapasHero.map((etapa, i) => (
				<li style={`--i: ${i}`}><span class="pn_etapa-n" aria-hidden="true">{i + 1}</span>{etapa}</li>
			))}
		</ol>
	</figure>

	<!-- 1. Para quem é -->
	<section class="section_icp" aria-labelledby="plano-para-quem-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large plano_publico">
				<div class="icp_header">
					<span class="eyebrow">Para quem é</span>
					<h2 id="plano-para-quem-titulo" class="plano_titulo">Antes de investir, tenha respostas</h2>
					<p class="plano_lead">Se você se reconhece em alguma destas frases, o Plano de Negócios foi feito para o seu momento.</p>
				</div>
				<ul class="plano_dores">
					{dores.map((d) => (
						<li class="icp_item plano_dor">
							<span class="plano_icone" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={d.icone} />
							</span>
							<h3>{d.dor}</h3>
							<p>
								{d.resposta}
								{d.caso && <> <a href={d.caso.url}>{d.caso.destaque.toLowerCase()}</a>.</>}
							</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<!-- 2. O que entra no projeto: o serviço completo, em duas fases -->
	<section class="section_beneficios" aria-labelledby="plano-escopo-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large beneficios_wrapper">
				<div class="beneficios_title">
					<span class="eyebrow">O que entra no projeto</span>
					<h2 id="plano-escopo-titulo" class="plano_titulo">Tudo o que o seu negócio precisa, em um só plano</h2>
					<p>Nada de contratar pesquisa, finanças e marketing em lugares diferentes: a {SITE.nome} constrói todas as frentes em um só projeto, para que cada parte converse com as outras.</p>
				</div>

				<ol class="plano_fases">
					{fases.map((fase, i) => (
						<li class="plano_fase">
							<div class="plano_fase-cabecalho">
								<span class="plano_fase-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
								<div>
									<h3>{fase.titulo}</h3>
									<p>{fase.pergunta}</p>
								</div>
							</div>
							<ul class="plano_frentes">
								{fase.frentes.map((f) => (
									<li class:list={['frente_mini-card', 'plano_frente', { 'is-link': f.href }]}>
										<h4>{f.titulo}</h4>
										<p>{f.texto}</p>
										{f.href && <a class="plano_frente-link" href={f.href}>Conheça a {f.consultoria}</a>}
									</li>
								))}
							</ul>
						</li>
					))}
				</ol>

				<div class="plano_rodape">
					<p>
						<strong>Por trás de tudo, a direção do negócio:</strong> o plano define direcionadores de curto a longo prazo,
						como missão, visão e valores. O escopo é fechado na proposta, sob medida para a realidade da sua empresa.
					</p>
					<a href="#formulario" class="button is-button-large">Quero meu plano completo</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 3. Diferencial: primeiro o mercado -->
	<section class="section_icp plano_diferencial" aria-labelledby="plano-diferencial-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large plano_diferencial-grid">
				<div>
					<div class="icp_header">
						<span class="eyebrow">Por que a {SITE.nome}</span>
						<h2 id="plano-diferencial-titulo" class="plano_titulo">Primeiro o mercado, depois a planilha</h2>
						<p class="plano_lead">Muitos planos começam pelas contas. O nosso começa pela pergunta que mais pesa no seu bolso: alguém vai comprar? Por isso a pesquisa de mercado e o plano de marketing fazem parte do projeto, e não só os números.</p>
					</div>
					<ul class="plano_motivos">
						{motivos.map((m) => (
							<li>
								<span class="plano_check" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES.check} />
								</span>
								<div>
									<h3>{m.titulo}</h3>
									<p>{m.texto}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
				<figure class="plano_citacao">
					<span class="eyebrow">Feito com você</span>
					<blockquote>
						<p>{CITACAO_PROJETO.texto}</p>
					</blockquote>
					<figcaption><strong>{CITACAO_PROJETO.autor}</strong> {CITACAO_PROJETO.cargo}, {SITE.nome}</figcaption>
				</figure>
			</div>
		</div>
	</section>
</SolucaoLayout>

<style>
	/* ---------- Cabeçalho: foto em arco com as etapas atravessando ---------- */
	.pn_hero {
		position: relative;
		padding-bottom: 2.25rem;
	}

	.pn_arco {
		--arco: 50% 50% var(--card-radius-xl) var(--card-radius-xl) / 40% 40% var(--card-radius-xl) var(--card-radius-xl);
		position: relative;
		width: min(100%, 30rem);
		aspect-ratio: 4 / 5;
		margin-left: auto;
		border-radius: var(--arco);
		box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.5);
	}

	/* Contorno laranja deslocado: o mesmo arco das curvas do site, como uma camada atrás da foto */
	.pn_arco::before {
		content: "";
		position: absolute;
		inset: -1.1rem 1.1rem 1.1rem -1.1rem;
		border: 2px solid color-mix(in srgb, var(--brand-laranja) 65%, transparent);
		border-radius: var(--arco);
		pointer-events: none;
	}

	.pn_arco :global(img) {
		position: relative;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--arco);
	}

	.pn_etapas {
		position: absolute;
		right: 0;
		bottom: 0;
		left: -14%;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
		list-style: none;
	}

	/* Linha do caminho: o mesmo degradê cinza → laranja da curva no fim do cabeçalho */
	.pn_etapas::before {
		content: "";
		position: absolute;
		top: 50%;
		right: 1rem;
		left: 1rem;
		height: 2px;
		background: linear-gradient(90deg, var(--gray500), var(--brand-laranja));
	}

	.pn_etapas li {
		position: relative;
		display: flex;
		gap: 0.55rem;
		align-items: center;
		min-height: 4.25rem;
		padding: 0.7rem 0.8rem;
		color: var(--white);
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.25;
		background: rgba(37, 40, 50, 0.86);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		border: 1px solid var(--border-hairline-dark);
		border-radius: var(--card-radius-md);
		animation: pn-etapa 0.8s var(--ease-out-expo) both;
		animation-delay: calc(var(--i) * 140ms + 250ms);
	}

	.pn_etapas li:last-child {
		border-color: color-mix(in srgb, var(--brand-laranja) 60%, transparent);
	}

	.pn_etapa-n {
		display: grid;
		flex: none;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		color: var(--brand-chumbo);
		font-size: 0.8rem;
		font-weight: 800;
		background: var(--primary600);
		border-radius: 50%;
	}

	@media (min-width: 1025px) and (max-height: 840px) {
		/* Em dobras desktop mais baixas, a sequência sobe para liberar o WhatsApp. */
		.pn_etapas {
			bottom: 3.5rem;
			transform: translateX(1.5rem);
		}
	}

	@keyframes pn-etapa {
		from { opacity: 0; transform: translateY(12px); }
	}

	@media (max-width: 1024px) {
		.pn_arco {
			margin-inline: auto;
		}

		.pn_hero {
			padding-bottom: 0;
		}

		.pn_etapas {
			position: relative;
			left: 0;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			margin-top: -2.5rem;
			padding-inline: 0.5rem;
		}

		.pn_etapas::before {
			display: none;
		}
	}

	/* Títulos do corpo maiores, para dar impacto (docx) */
	.plano_titulo {
		font-size: clamp(1.9rem, 3.2vw, 2.75rem);
		line-height: 1.12;
		text-wrap: balance;
	}

	.plano_lead {
		margin-top: 1rem;
		color: var(--gray600);
		font-size: 1.05rem;
		line-height: 1.65;
	}

	/* 1. Para quem é */
	.plano_publico {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}

	.plano_publico .icp_header {
		margin-bottom: 0;
	}

	.plano_dores {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		list-style: none;
	}

	.plano_dor {
		gap: 0.75rem;
	}

	.plano_dor h3 {
		font-size: 1.125rem;
		font-weight: 800;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.plano_dor p {
		font-size: 0.95rem;
	}

	.plano_dor a {
		color: var(--primary700);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.plano_icone {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		color: var(--primary700);
		background: var(--primary50);
		border-radius: 0.75rem;
	}

	.plano_icone svg {
		width: 1.4rem;
		height: 1.4rem;
	}

	/* 2. Fases do escopo (seção escura) */
	.plano_fases {
		list-style: none;
	}

	.plano_fase {
		display: grid;
		grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
		gap: 1.5rem clamp(2rem, 4vw, 3.5rem);
		padding: clamp(1.75rem, 3vw, 2.5rem) 0;
		border-top: 1px solid var(--border-hairline-dark);
	}

	.plano_fase:last-child {
		border-bottom: 1px solid var(--border-hairline-dark);
	}

	.plano_fase-num {
		display: block;
		margin-bottom: 1rem;
		font-size: clamp(3rem, 5vw, 4.5rem);
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.04em;
		color: rgba(249, 255, 252, 0.08);
		-webkit-text-stroke: 1px rgba(249, 255, 252, 0.45);
	}

	.plano_fase-cabecalho h3 {
		font-size: clamp(1.35rem, 2vw, 1.65rem);
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: var(--white);
	}

	.plano_fase-cabecalho p {
		margin-top: 0.5rem;
		color: var(--graywarm300);
		line-height: 1.55;
	}

	.plano_frentes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		align-content: start;
		list-style: none;
	}

	.plano_frente {
		position: relative;
		display: flex;
		flex-direction: column;
	}

	/* Só os cards com link reagem ao mouse */
	.plano_frente:not(.is-link):hover {
		transform: none;
		border-color: var(--border-hairline-dark);
	}

	.plano_frente h4 {
		font-size: 1.1rem;
	}

	.plano_frente p {
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.plano_frente-link {
		align-self: flex-start;
		margin-top: auto;
		padding-top: 1rem;
		color: var(--primary200);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* O card inteiro leva à consultoria (docx: clicar em "Plano financeiro" leva à Consultoria Financeira) */
	.plano_frente-link::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.plano_frente-link::after {
		content: "\00a0→";
		content: "\00a0→" / "";
	}

	.plano_frente.is-link:hover .plano_frente-link,
	.plano_frente.is-link:focus-within .plano_frente-link {
		color: var(--white);
	}

	.plano_frente.is-link:focus-within {
		border-color: var(--primary500);
	}

	.plano_rodape {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem 2.5rem;
