							<h3>{d.frase}</h3>
							<p>{d.ganho}</p>
							<a href={d.href} class="mercadologica_dor-link">Como resolvemos: {d.frente} <span aria-hidden="true">↓</span></a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<!-- 2. O que entra no projeto: introdução fixa à esquerda, frentes em linha do tempo à direita -->
	<section id="o-que-entra" class="section_beneficios mercadologica_escopo" aria-labelledby="merc-escopo">
		<div class="page-padding padding-section-medium">
