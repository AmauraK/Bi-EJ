<script>
	// Índice fixo com a seção ativa em destaque e efeito de entrada do texto.
	const raiz = document.querySelector<HTMLElement>('[data-case]');

	if (raiz && 'IntersectionObserver' in window) {
		const links = Array.from(raiz.querySelectorAll<HTMLAnchorElement>('[data-indice]'));
		const ativar = (id: string) =>
			links.forEach((a) => (a.hash === `#${id}` ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));

		// Ativa é a seção que cruza a faixa entre 35% e 40% da altura da tela.
		const indice = new IntersectionObserver(
			(entradas) => {
				entradas.forEach((e) => {
					if (e.isIntersecting) ativar(e.target.id);
				});
			},
			{ rootMargin: '-35% 0px -60% 0px' }
		);
		links.forEach((a) => {
			const secao = document.getElementById(a.hash.slice(1));
			if (secao) indice.observe(secao);
			a.addEventListener('click', () => ativar(a.hash.slice(1)));
		});
		ativar('problema');

		// Efeito de entrada: desligado no modo de menos movimento (o CSS também não anima).
		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const revelar = new IntersectionObserver(
				(entradas) => {
					entradas.forEach((e) => {
						if (!e.isIntersecting) return;
						e.target.classList.add('is-visivel');
						revelar.unobserve(e.target);
					});
				},
				{ rootMargin: '0px 0px -8% 0px' }
			);
			raiz.querySelectorAll('.revelar').forEach((el) => {
				// O que já está na tela aparece sem animação, para não piscar.
				if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visivel');
				else revelar.observe(el);
			});
			raiz.classList.add('tem-revelar');
		}
	}
</script>

