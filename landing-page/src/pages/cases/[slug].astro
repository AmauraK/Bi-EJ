// Página de cada case (as 8 URLs atuais): capa com o "spoiler", índice fixo Problema Inicial · Nossa Solução ·
// Resultados Finais com a seção ativa em destaque, texto com efeito de entrada (desligado no modo de menos
// movimento), depoimento do cliente, "Histórias como essa", CTA para o formulário da solução e JSON-LD Article.
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ImagemReservada from '../../components/ImagemReservada.astro';
import CaseCard from '../../components/CaseCard.astro';
import Depoimentos from '../../components/Depoimentos.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { SITE, NUMEROS, CASES, DEPOIMENTOS, ATUALIZADO_EM, type Case } from '../../consts';
import { CONTEUDO, solucoesDo, tagDo, type ConteudoCase } from '../../components/cases/conteudo';

export function getStaticPaths() {
	return CASES.map((c) => ({ params: { slug: c.slug }, props: { caso: c } }));
}

const { caso } = Astro.props as { caso: Case };

// Case sem texto integral em conteudo.ts: usa as linhas de CASES e mostra o marcador.
const completo = caso.slug in CONTEUDO;
const partes: ConteudoCase = CONTEUDO[caso.slug] ?? {
	para: caso.cliente,
	resumo: '',
	problema: [`${caso.problema}.`],
	solucao: [`${caso.solucao}.`],
	resultados: [{ titulo: caso.destaque }],
};

const solucoes = solucoesDo(caso);
const formulario = `${solucoes[0].url}#formulario`;
const nomes = new Intl.ListFormat('pt-BR', { type: 'conjunction' }).format(solucoes.map((s) => s.nome));
const url = new URL(caso.url, SITE.url).href;
const descricao = `${caso.cliente}, case da ${SITE.nome} (${caso.segmento}). Desafio: ${caso.problema}. Resultado: ${caso.destaque}.`;

const depoimentos = DEPOIMENTOS.filter((d) => d.autor === caso.cliente);

// "Histórias como essa": primeiro os cases que compartilham uma solução; completa com os outros até 3.
const outros = CASES.filter((c) => c.slug !== caso.slug);
const parecido = (c: Case) => c.solucoes.some((s) => caso.solucoes.includes(s));
const historias = [...outros.filter(parecido), ...outros.filter((c) => !parecido(c))].slice(0, 3);

const PARTES = [
	{ id: 'problema', rotulo: 'Problema Inicial' },
	{ id: 'solucao', rotulo: 'Nossa Solução' },
	{ id: 'resultados', rotulo: 'Resultados Finais' },
];

const artigo = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: caso.titulo,
	description: descricao,
	url,
	mainEntityOfPage: url,
	inLanguage: 'pt-BR',
	articleSection: 'Cases de sucesso',
	datePublished: partes.publicado,
	dateModified: ATUALIZADO_EM,
	about: solucoes.map((s) => ({ '@type': 'Service', name: s.nome, url: new URL(s.url, SITE.url).href })),
	author: { '@type': 'Organization', name: SITE.nome, url: SITE.url },
	publisher: { '@type': 'Organization', name: SITE.nome, url: SITE.url, logo: { '@type': 'ImageObject', url: SITE.logo } },
};
