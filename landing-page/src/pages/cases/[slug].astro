<Layout titulo={`${caso.cliente} - Cases de Sucesso - EJFGV`} descricao={descricao} ctaHref={formulario} jsonLd={artigo}>
	<div class="case-capa">
		<PageHeader
			titulo={caso.titulo}
			kicker={`Case de sucesso · ${caso.segmento}`}
			descricao={`Case de ${nomes} da ${SITE.nome} para ${partes.para}. A ${SITE.nome} é a ${SITE.nomeCompleto} e faz consultoria desde ${NUMEROS.fundacao}.`}
			escuro
