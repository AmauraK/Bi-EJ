<script>
  (function () {
    const filterButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-case-filter]')
    );
    const caseCards = Array.from(
      document.querySelectorAll<HTMLElement>('[data-case-card]')
    );
    const statusCounter = document.getElementById('casesStatusCounter');

    if (filterButtons.length === 0 || caseCards.length === 0) return;

    function applyFilter(selectedSlug: string, selectedLabel: string) {
      filterButtons.forEach((btn) => {
        const isActive = btn.getAttribute('data-case-filter') === selectedSlug;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        btn.classList.toggle('is-active', isActive);
      });

      let visiblePublished = 0;

      caseCards.forEach((card) => {
        const isBiPlaceholder = card.hasAttribute('data-case-placeholder-bi');
        const solucoesAttr = card.getAttribute('data-solucoes') || '';
        const solucoesList = solucoesAttr
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);

        let shouldShow = false;
        if (selectedSlug === 'todos') {
          shouldShow = true;
        } else {
          shouldShow = solucoesList.includes(selectedSlug);
        }

        if (shouldShow) {
          card.removeAttribute('hidden');
          if (!isBiPlaceholder) visiblePublished++;
        } else {
          card.setAttribute('hidden', '');
        }
      });

      if (statusCounter) {
        if (selectedSlug === 'todos') {
          statusCounter.innerHTML = `Exibindo <strong>${visiblePublished}</strong> estudos de caso publicados`;
        } else if (selectedSlug === 'consultoria-business-intelligence' && visiblePublished === 0) {
          statusCounter.innerHTML = `Filtro <strong>${selectedLabel}</strong>: case em validação pelo Marketing`;
        } else {
          const plural = visiblePublished === 1 ? 'estudo de caso' : 'estudos de caso';
          statusCounter.innerHTML = `Exibindo <strong>${visiblePublished}</strong> ${plural} em <strong>${selectedLabel}</strong>`;
        }
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-case-filter') || 'todos';
        const label = (btn.textContent || 'Todos').trim();
        applyFilter(slug, label);
      });
    });
  })();
</script>

