---
// Listagem de cases: capa reservada, filtros por tipo de consultoria (sem JS, todos aparecem),
// cards com o resultado em destaque (o "spoiler"), logos, depoimentos e CTA.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Foto from '../components/Foto.astro';
import CaseCard from '../components/CaseCard.astro';
import LogoWall from '../components/LogoWall.astro';
import Depoimentos from '../components/Depoimentos.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE, NUMEROS, SOLUCOES, CASES, FOTOS } from '../consts';
import { tagDo } from '../components/cases/conteudo';

// Ordem dos filtros decidida em 26/10/2026. Só aparece o filtro que tem case publicado: o de BI
// fica oculto até existir um case de BI em CASES (consts.ts) e volta sozinho quando ele for cadastrado.
const FILTROS = ['plano-de-negocios', 'consultoria-business-intelligence', 'consultoria-operacional', 'consultoria-mercadologica', 'consultoria-financeira']
	.map((slug) => SOLUCOES.find((s) => s.slug === slug)!)
	.filter((s) => CASES.some((c) => c.solucoes.includes(s.slug)));

// Ritmo da grade de 3 colunas: o 1º case é o destaque grafite largo (linha 1, à esquerda); na linha 2
// o grafite fica à direita (5º case) e na linha 3 no meio (7º). Mudou a ordem de CASES? Revise aqui.
const ESCUROS = [4, 6];

const descricao = 'Cases de sucesso da EJFGV, a Empresa Júnior da Fundação Getulio Vargas: projetos reais com o problema inicial, a solução e os resultados. Filtre por tipo de consultoria.';

const colecao = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Cases de sucesso da EJFGV',
	description: descricao,
	url: new URL('/cases-de-sucesso/', SITE.url).href,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: CASES.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.titulo, url: new URL(c.url, SITE.url).href })),
	},
};
---

<Layout titulo="Cases de Sucesso - EJFGV" descricao={descricao} jsonLd={colecao}>
	<PageHeader
		titulo="Cases de sucesso: histórias transformadas pela EJFGV"
		kicker={`${SITE.nome} · Empresa Júnior da FGV desde ${NUMEROS.fundacao}`}
		descricao={`Os cases de sucesso da ${SITE.nome}, a ${SITE.nomeCompleto}, são projetos reais de consultoria feitos por alunos da FGV para empresas de diferentes setores e portes. Desde ${NUMEROS.fundacao}, já são mais de ${NUMEROS.projetos} projetos entregues. Em cada case, você vê o problema inicial, a nossa solução e os resultados finais.`}
		escuro
	>
		<Fragment slot="titulo">Cases de sucesso: <span class="highlight-purpose">histórias transformadas</span> pela EJFGV</Fragment>
		<p class="hero_description">Veja como o seu negócio pode ser o próximo.</p>
		<Fragment slot="acoes">
			<a href="/contato/#formulario" class="button is-button-large">Solicite seu diagnóstico gratuito</a>
			<a href="#lista-cases" class="button-tertiary">Ver os cases ↓</a>
		</Fragment>
		<figure slot="midia" class="hero-photo-frame">
			<Foto foto={FOTOS.equipeConvite} classe="home-hero_image" />
		</figure>
	</PageHeader>

	{/* Onda em 3 camadas (grafite, cinza médio, cinza claro) entre a capa escura e a lista clara */}
	<div class="casos_onda" aria-hidden="true">
		<svg viewBox="0 0 1440 130" preserveAspectRatio="none">
			<path class="onda-3" d="M0 0H1440V82C1150 112 800 66 440 56C260 51 110 60 0 76Z" />
			<path class="onda-2" d="M0 0H1440V56C1150 86 800 40 440 30C260 25 110 34 0 50Z" />
			<path class="onda-1" d="M0 0H1440V30C1150 60 800 14 440 4C260 -1 110 8 0 24Z" />
		</svg>
	</div>

	<section id="lista-cases" class="section_depoimentos casos" aria-labelledby="lista-cases-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="icp_header">
					<span class="eyebrow">Cases por tipo de consultoria</span>
					<h2 id="lista-cases-titulo">Veja o resultado de cada projeto</h2>
				</div>

				<div class="tag-chips casos_filtros" role="group" aria-label="Filtrar cases por tipo de consultoria" data-filtros>
					<button type="button" class="tag-chip" aria-pressed="true" data-filtro="todos">Todos</button>
					{FILTROS.map((s) => <button type="button" class="tag-chip" aria-pressed="false" data-filtro={s.slug}>{s.rotulo}</button>)}
				</div>
				<p class="casos_status" aria-live="polite" data-filtro-status></p>

				<ul class="cases_grid casos_lista">
					{CASES.map((c, i) => (
						<li data-solucoes={c.solucoes.join(' ')} class:list={{ 'is-destaque': i === 0 }}>
							<CaseCard tag={tagDo(c)} metrica={c.destaque} titulo={c.cliente} desafio={`${c.problema}.`} href={c.url} destaque={i === 0} escuro={ESCUROS.includes(i)} />
						</li>
					))}
					{/* O card provisório de BI ("A preencher") saiu em 02/11/2026. Para reativar, cadastre o case
					    de BI em CASES (consts.ts) com solucoes: ['consultoria-business-intelligence']: ele entra
					    nesta lista e o filtro de BI reaparece. */}
				</ul>
			</div>
		</div>
	</section>

	<LogoWall />

	<section class="section_depoimentos" aria-labelledby="depoimentos-titulo">
		<div class="page-padding padding-section-medium">
			<div class="container-large">
				<div class="icp_header">
					<span class="eyebrow">Depoimentos</span>
					<h2 id="depoimentos-titulo">Veja o que falam sobre nós</h2>
				</div>
				<Depoimentos />
			</div>
		</div>
	</section>

	<CtaBanner titulo="Seu negócio pode ser o próximo case de sucesso da EJFGV." href="/contato/#formulario" rotulo="Fale com um Especialista" escuro />

<style>
	/* Fundo branco igual ao da lista; a camada de cima tem a cor da capa, então a emenda some */
	.casos_onda {
		margin-top: -1px;
		background: var(--white);
	}

	.casos_onda svg {
		display: block;
		width: 100%;
		height: clamp(3rem, 8vw, 7.5rem);
	}

	.onda-1 { fill: var(--graywarm900); }
	.onda-2 { fill: color-mix(in srgb, var(--graywarm900) 55%, var(--white)); }
	.onda-3 { fill: color-mix(in srgb, var(--graywarm900) 25%, var(--white)); }

	/* A onda já separa a capa da lista: tira parte do respiro de cima da lista */
	.casos > .padding-section-medium {
		padding-top: clamp(1.5rem, 3vw, 2.5rem);
	}

	.casos_filtros {
		margin-bottom: 2rem;
	}

	/* Só para leitores de tela: anuncia o filtro aplicado */
	.casos_status {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.casos_lista {
		list-style: none;
		margin-bottom: 0;
	}

	/* Ritmo: o primeiro case em destaque ocupa 2 colunas (só com 3 colunas). `dense` evita buracos ao filtrar. */
	.casos_lista {
		grid-auto-flow: dense;
	}

	/* Repassa as linhas da grade ao card (subgrid do CaseCard) */
	.casos_lista > li {
		display: grid;
		grid-row: span 2;
		grid-template-rows: subgrid;
		row-gap: 0;
	}

	@media (min-width: 1025px) {
		.casos_lista > li.is-destaque {
			grid-column: span 2;
		}
	}

	.casos_lista > li[hidden] {
		display: none;
	}

	/* Celular: respiro no fim da lista para o botão fixo do WhatsApp (52 px + 20 px) não cobrir o último card */
	@media (max-width: 767px) {
		.casos > .padding-section-medium {
			padding-bottom: calc(clamp(3.75rem, 6.5vw, 6rem) + 4.5rem);
		}
	}

	@media (min-width: 768px) and (max-width: 1024px) {
		.casos_lista {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

<script>
	// Filtro por tipo de consultoria. Sem JS, todos os cases ficam visíveis.
	const grupo = document.querySelector<HTMLElement>('[data-filtros]');
	const status = document.querySelector<HTMLElement>('[data-filtro-status]');
	const itens = document.querySelectorAll<HTMLElement>('[data-solucoes]');

	if (grupo) {
		grupo.addEventListener('click', (e) => {
			const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filtro]');
			if (!chip) return;
			const filtro = chip.dataset.filtro!;
			grupo.querySelectorAll('[data-filtro]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
			itens.forEach((item) => {
				item.hidden = filtro !== 'todos' && !item.dataset.solucoes!.split(' ').includes(filtro);
			});
			if (status) status.textContent = filtro === 'todos' ? 'Mostrando todos os cases' : `Mostrando cases de ${chip.textContent}`;
		});
	}
</script>

</Layout>
